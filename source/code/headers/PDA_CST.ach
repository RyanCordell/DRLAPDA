#define DRLA_ITEMELEMENTS 3

#define TEXT_OFFSET 13 // "PDA_ASSEMBLY_" string length

#define INF_HOLDTIME 0.0
#define OPAQUE       1.0

#define ARM_HEIGHT        (int)(34 / NEW_RESOLUTION_Y)

#define EQUIPMENT_ICON_X  (int)(PDA_SCREEN_X + 35.0)
#define EQUIPMENT_ICON_Y  60.0
#define EQUIPMENT_TEXT_Y  (int)(EQUIPMENT_ICON_Y + 80.0)

#define HOLD_THRESHOLD  10

// All things PDA related
// const fixed NEW_RESOLUTION_WIDTH = 384, NEW_RESOLUTION_HEIGHT = 288;  // 380 / 320 = 1.1875  |  260 / 200 = 1.3
#define NEW_RESOLUTION_WIDTH   400.0
#define NEW_RESOLUTION_HEIGHT  300.0

#define OLD_RESOLUTION_WIDTH   320.0
#define OLD_RESOLUTION_HEIGHT  200.0

#define NEW_RESOLUTION_X   (fixed)(NEW_RESOLUTION_WIDTH / OLD_RESOLUTION_WIDTH)
#define NEW_RESOLUTION_Y   (fixed)(NEW_RESOLUTION_HEIGHT / OLD_RESOLUTION_HEIGHT)

// The following four constants are all based off the RLZPDA2 graphic itself.
#define PDA_SCREEN_X       18 // 17 pixels from graphic left start + 1 px screen padding
#define PDA_SCREEN_Y       20 // 19 pixels from graphic top start + 1 px screen padding.
#define PDA_SCREEN_WIDTH  255 // Should be 256, taking into account 1px screen padding...
#define PDA_SCREEN_HEIGHT 162 // Should be 162, taking into account 1px screen padding...
#define PDA_SCREEN_HEADER  13
// -------------
#define PDA_SCREEN_X_SCALED       (PDA_SCREEN_X      * NEW_RESOLUTION_X)
#define PDA_SCREEN_Y_SCALED       (PDA_SCREEN_Y      * NEW_RESOLUTION_Y)
#define PDA_SCREEN_WIDTH_SCALED   (PDA_SCREEN_WIDTH  * NEW_RESOLUTION_X)
#define PDA_SCREEN_HEIGHT_SCALED  (PDA_SCREEN_HEIGHT * NEW_RESOLUTION_Y)
// -------------
#define PDA_HEADER_X       (PDA_SCREEN_X_SCALED + 0.0              )
#define PDA_HEADER_Y       (PDA_SCREEN_Y_SCALED - 1.0              )
#define PDA_HEADING_X      (PDA_SCREEN_WIDTH    / 2 + 15.0         ) // Scaled by PDA_DrawHeaderText
#define PDA_HEADER_HEIGHT  (PDA_SCREEN_Y_SCALED - 12.0             )
#define PDA_BODY_X         (PDA_SCREEN_X_SCALED + 0.0              )
#define PDA_BODY_Y         (PDA_HEADER_Y        + PDA_HEADER_HEIGHT)
// -------------
#define PDA_SCROLLABLE_BODY_Y       (int)(PDA_BODY_Y                                  )
#define PDA_SCROLLABLE_BODY_HEIGHT  (int)(PDA_SCREEN_HEIGHT_SCALED - PDA_HEADER_HEIGHT)
// #define PDA_SCROLLABLE_BODY_Y       (int)(((PDA_BODY_Y       ) * NEW_RESOLUTION_Y) -              1)
// #define PDA_SCROLLABLE_BODY_HEIGHT  (int)(((PDA_SCREEN_HEIGHT) * NEW_RESOLUTION_Y) - PDA_BODY_Y + 1)
#define PDA_SCROLL_TOP      20.0
#define PDA_SCROLL_BOTTOM  -60.0
// -------------
#define PDA_MENU_TOOLTIP_X       (PDA_SCREEN_WIDTH_SCALED / 2 + 6)
#define PDA_MENU_TOOLTIP_Y       (PDA_BODY_Y)
#define PDA_MENU_TOOLTIP_WIDTH   140
#define PDA_MENU_TOOLTIP_HEIGHT  (PDA_SCROLLABLE_BODY_HEIGHT)
// -------------
#define PDA_FLOATING_TOOLTIP_GRAPHIC_X       (PDA_BODY_X                     )
#define PDA_FLOATING_TOOLTIP_GRAPHIC_Y       (PDA_SCROLLABLE_BODY_Y      + 15)
#define PDA_FLOATING_TOOLTIP_GRAPHIC_WIDTH   (PDA_SCREEN_WIDTH           + 80)
#define PDA_FLOATING_TOOLTIP_GRAPHIC_HEIGHT  (PDA_SCROLLABLE_BODY_HEIGHT + 60)
#define PDA_FLOATING_TOOLTIP_GRAPHIC_WRAP    (PDA_SCREEN_WIDTH           + 10) // The graphic doesn't wrap though..

#define PDA_FLOATING_TOOLTIP_X       (PDA_BODY_X                      )
#define PDA_FLOATING_TOOLTIP_Y       (PDA_SCROLLABLE_BODY_Y      +  15)
#define PDA_FLOATING_TOOLTIP_WIDTH   (PDA_SCREEN_WIDTH           +  80)
#define PDA_FLOATING_TOOLTIP_HEIGHT  (PDA_SCROLLABLE_BODY_HEIGHT + 165)
#define PDA_FLOATING_TOOLTIP_WRAP    (int)((PDA_SCREEN_WIDTH - PDA_BODY_X) / NEW_RESOLUTION_X + 42)
// -------------
#define PDA_MAX_ARMOR_IN_INV  4
#define PDA_MAX_ARMOR_WORN    2
#define PDA_MAX_MOD_PACKS     7

#define PDA_MENU_ICON_LEFT_X   (fixed)(20.0  + X_LEFT_EDGE)
#define PDA_MENU_ICON_RIGHT_X  (fixed)(140.0 + X_LEFT_EDGE)

#define PDA_MENU_TEXT_LEFT_X   (fixed)(PDA_MENU_ICON_LEFT_X  + 30.0)
#define PDA_MENU_TEXT_RIGHT_X  (fixed)(PDA_MENU_ICON_RIGHT_X + 30.0)

#define PDA_NormalY  (fixed)(PDA_SCREEN_Y)

#define PDA_TAB_START_X    5.0
#define PDA_TAB_Y          5.0
#define PDA_TAB_W          12
#define PDA_TAB_H          7
#define PDA_TAB_MARGIN     2.0

#define DEFAULT_BUTTON_ALPHA  0.6

