// Mouse cursor, anything that does NOT require a dirty check, ...
function void DisplayIconAlways (str Sprite, int ID, fixed X, fixed Y, fixed DelayTime, fixed Alpha) {
    if (CheckFont(Sprite)) {
        SetFont(Sprite);
        HudMessage(s:"A\n"; HUDMSG_ALPHA, ID, CR_UNTRANSLATED, X, Y, DelayTime, Alpha);
        PDA_DefaultFont();
    }
}

// I need to merge these two somehow. Probably w/ scrollable bool?
function void DisplayIcon (str Sprite, int ID, fixed X, fixed Y, fixed DelayTime, fixed Alpha) {
    if (CheckFont(Sprite)) {
        SetFont(Sprite);
        HudMessage(s:"A\n"; HUDMSG_ALPHA, ID, CR_UNTRANSLATED, X, Y, DelayTime, Alpha);
        PDA_DefaultFont();
    }
    TraceLog("DisplayIcon");
}

function void DisplayIconScrollable (str Sprite, int ID, fixed X, fixed Y, fixed DelayTime, fixed Alpha) {
    if (CheckFont(Sprite)) {
        SetFont(Sprite);
        HudMessage(s:"A\n"; HUDMSG_ALPHA, ID, CR_UNTRANSLATED,
            X,
            (int)((Y + PDA_Local.scrollingY) * NEW_RESOLUTION_Y) + Y_TOP_EDGE,
            DelayTime, Alpha);
        PDA_DefaultFont();
    }
    TraceLog("DisplayIconScrollable");
}
