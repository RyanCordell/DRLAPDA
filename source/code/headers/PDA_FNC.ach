    );
    // thisButton.textPos[TB_Y]     = (int)(thisButton.gfxPos[TB_Y] * NEW_RESOLUTION_Y) + 2.0 + 10.0;

    thisButton.alpha = alpha;

    // SetFont(thisButton.textFont);
    // HudMessage("%l:", stringArray[id]; thisButton.textFlags, PDA_ASSEMBLY_ID_END + id, CR_UNTRANSLATED,
    //     thisButton.textPos[TB_X], thisButton.textPos[TB_Y],
    //     0.INF_HOLDTIME, OPAQUE);

    TraceLog("PDA_CreateModPackDisplay");
    return thisButton;
}

function void PDA_ButtonLogic (int id, bool onlyVisual) {
    #define thisButton PDA_LocalButton[id]
    #define buttonType PDA_LocalButton[id].type

    if (buttonType == "tab") {
        PDA_SetupHeaderBounds();
        /*
        if (PDA_Local.category != PDA_MENU && PDA_Local.page == thisButton.actionParam) {
            // I wonder why I did this..
            // thisButton.state = button_hovered;
            thisButton.alpha = 1;
        }*/
    }

    if (buttonType == "" || StrLen(buttonType) == 0) {
        log("ERROR: Button with ID %d: has no valid type!", thisButton.id);
        return;
    }

    if (!onlyVisual) {
        buttonBoundsDefault(thisButton);

        if (thisButton.state != thisButton.oldState) {
            PDA_SetFullDirty();
        }

        switch (thisButton.state) {
            case button_hovered:
                PDA_SetFullDirty();
                if (buttonType == "equipment") {
                    if (StrLen(thisButton.tooltip) != 0 && PDA_Local.page != EQUIPMENT_PAGE_INFO) {
                        PDA_SetupFloatingTooltip("PTIP", thisButton.tooltip);
                        // thisButton.alpha = pulser(2.0, 0.8);
                        thisButton.alpha = 1.0;
                    }
                }
                break;
            case button_clicked:
                #include "./PDA_ACT.ach"

                PDA_LocalMouse.state = cursor_default;
                PDA_LocalMouse.oldState = PDA_LocalMouse.state;
                break;
        }

        if (buttonStoppedHovering && buttonType == "equipment") {
            PDA_SetFullDirty();
            PDA_SetupFloatingTooltip("", "");
        }
    }

    // End
    thisButton.oldState = thisButton.state;

    TraceLog("PDA_ButtonLogic");
}


function void PDA_DrawButton (int id, str message, bool onlyVisual, bool clear) {
    #define thisButton PDA_LocalButton[id]
    #define buttonType PDA_LocalButton[id].type
    #define SCROLL_OFFSET ((buttonType != "tab" && buttonType != "fixed") ? SCALED_SCROLL : 0.0)

    int warningID = id - 50;
    int newColor = CR_UNTRANSLATED;

    if (warningID < 0) warningID = 0;
    if (warningID > 4) warningID = 4;

    switch (thisButton.state) {
        case button_hovered:
            if (StrLen(message) != 0 && (buttonType == "menu" || buttonType == "beast")) {
                PDA_SetFullDirty();

                // Avoid adding text alignment modifiers to PDA_Draw text functions
                PDA_DrawTooltipText(HUDMSG_PLAIN, PDA_CAT_DESCRIPTION, CR_UNTRANSLATED,
                    -10.0, 0.0,
                    INF_HOLDTIME, OPAQUE, DEFAULT_ALIGN, DEFAULT_ALIGN, s:message);
            }
            break;
    }

    if (buttonStoppedHovering && (buttonType == "menu" || buttonType == "beast")) {
        PDA_SetFullDirty();

        PDA_DrawTooltipText(HUDMSG_PLAIN, PDA_CAT_DESCRIPTION, CR_UNTRANSLATED,
            0.0, 0.0,
            INF_HOLDTIME, 0.0, DEFAULT_ALIGN, DEFAULT_ALIGN, s:"");
    }

    if (!PDA_ScrollableNeedsDraw) {
        return;
    }

    // think i'll just opt for the if-ladder instead
    if (buttonType == "menu") {
        defaultHoverPulse(thisButton);
    } else if (buttonType == "tab") {
        brightOnHover(thisButton);
    } else if (buttonType == "generic") {
        defaultHoverPulse(thisButton);
    } else if (buttonType == "fixed") {
        defaultHoverPulse(thisButton);
    } else if (buttonType == "assembly") {
        if (thisButton.tooltip != "???") {
            defaultHoverPulse(thisButton);
        } else {
            brightOnHover(thisButton);
        }
    } else if (buttonType == "beast") {
        defaultHoverPulse(thisButton);
    } else if (buttonType == "hud") {
        defaultHoverPulse(thisButton);
    } else if (buttonType == "equipment") {
        if (PDA_Local.page == 1) {
            if (StrLeft(thisButton.label, 3) == "E: ") {
                thisButton.alpha = OPAQUE;
            } else {
                defaultHoverPulse(thisButton);
            }
        }
        if (PDA_Local.page == 2) {
            if (thisButton.id == PDA_Local.equipmentId[EQUIPPED_WORN_ARMOR]) {
                if (localShowArmor) {
                    thisButton.alpha = OPAQUE;
                } else {
                    thisButton.alpha = hoverPulse(thisButton);
                }

            } else if (thisButton.id == PDA_Local.equipmentId[EQUIPPED_WORN_BACKP]) {
                if (localShowBackpack) {
                    thisButton.alpha = OPAQUE;
                } else {
                    thisButton.alpha = hoverPulse(thisButton);
                }

            } else if (thisButton.id == PDA_Local.equipmentId[EQUIPPED_WORN_BOOTS]) {
                if (localShowBoots) {
                    thisButton.alpha = OPAQUE;
                } else {
                    thisButton.alpha = hoverPulse(thisButton);
                }

            }
        }
    } else if (buttonType == "modpack") {

    }

    // Button graphic

    PrintSpriteAlpha(thisButton.graphic, thisButton.graphicID, (int)(thisButton.gfxPos[TB_X]) + X_LEFT_EDGE, (int)(thisButton.gfxPos[TB_Y] + SCROLL_OFFSET) + Y_TOP_EDGE, INF_HOLDTIME, thisButton.alpha, false);

    if (buttonType == "beast") {
        newColor = thisButton.textColor;

        if (PDA_Local.newEntry[warningID]) {
            newColor = CR_GOLD;

            if (PDA_Local.page == 1) {
                HudMessage(s:"New entry!\n";
                    // honestly, i should re-locate these into separate IDs
                    HUDMSG_ALPHA, id + 5, CR_GREEN, thisButton.textPos[TB_X] + thisButton.width - 10.0, (int)(thisButton.textPos[TB_Y] - 6.0 + SCROLL_OFFSET), 0.0, pulser(2.0, DEFAULT_BUTTON_ALPHA + 0.2)
                );
            }
        }
    }

    // Button text
    SetFont(thisButton.textFont);
    PDA_HudDirty(thisButton.textFlags, thisButton.textID, newColor,
        (int)(thisButton.textPos[TB_X]),
        (int)(thisButton.textPos[TB_Y] + SCROLL_OFFSET),
        INF_HOLDTIME, thisButton.alpha, DEFAULT_ALIGN, DEFAULT_ALIGN, s:thisButton.label);

    if (clear) {
        // Button graphic
        PrintSpriteAlpha("TNT1A0", thisButton.graphicID, 0.0, 0.0, INF_HOLDTIME, 0.0, B_CLEAR);

        PDA_DefaultFont();
        // Button text
        PDA_HudDirty(thisButton.textFlags, thisButton.textID, newColor, 0.0, 0.0, INF_HOLDTIME, 0.0, DEFAULT_ALIGN, DEFAULT_ALIGN, s:" ");

        // Page-wide tooltip
        if (buttonType == "menu") {
            PDA_TooltipDirty(HUDMSG_PLAIN, PDA_CAT_DESCRIPTION, CR_UNTRANSLATED, 0.0, 0.0, INF_HOLDTIME, 0.0, DEFAULT_ALIGN, DEFAULT_ALIGN, s:" ");
        }
    }

    TraceLog("PDA_DrawButton");
}

function void PDA_ButtonHandler (int id, str message, bool onlyVisual, bool clear) {
    PDA_ButtonLogic(id, onlyVisual);

    PDA_DrawButton(id, message, onlyVisual, clear);
    TraceLog("PDA_ButtonHandler");
}

function void PDA_HandleHeader(void) {
    if (PDA_CategoryChanged || PDA_PageChanged) {
        PDA_SetFullDirty();

        switch (PDA_Local.category) {
            case PDA_MENU:
                PDA_Local.pageMax = 1;

                PDA_Local.heading = "PDA_MENU_HEADER";
                break;

            case PDA_CLASSES:
                PDA_Local.pageMax = 2;

                switch(PDA_Local.page) {
                    case CLASSES_PAGE_PERKS: PDA_Local.heading = "PDA_CLASS_HEADER1"; break;
                    case CLASSES_PAGE_STORY: PDA_Local.heading = "PDA_CLASS_HEADER2"; break;
                }
                break;

            case PDA_WEAPONS:
                PDA_Local.pageMax = 3;

                switch (PDA_Local.page) {
                    case WEAPON_PAGE_STORY:
                        PDA_Local.heading = "PDA_WEAPON_HEADER";
                        break;
                    case WEAPON_PAGE_MODPACK_EFFECTS:
                        PDA_Local.heading = "PDA_MODPACK_HEADER";
                        break;
                    case WEAPON_PAGE_ARTIFACT_EFFECTS:
                        PDA_Local.heading = "PDA_DEMONARTIFACT_HEADER";
                        break;
                }
                break;

            case PDA_BESTIARY:
                PDA_Local.pageMax = 6;

                switch (PDA_Local.page) {
                    case 1: PDA_Local.heading = "PDA_BESTIARY_HEADER"; break;
                    case 2: PDA_Local.heading = "PDA_BESTIARY_HEADER_UV";
                    beast_info[BEAST__LV_COLOR] = CR_WHITE;     break;
                    case 3: PDA_Local.heading = "PDA_BESTIARY_HEADER_NM";
                    beast_info[BEAST__LV_COLOR] = CR_BRICK;     break;
                    case 4: PDA_Local.heading = "PDA_BESTIARY_HEADER_TP";
                    beast_info[BEAST__LV_COLOR] = CR_LIGHTBLUE; break;
                    case 5: PDA_Local.heading = "PDA_BESTIARY_HEADER_AR";
                    beast_info[BEAST__LV_COLOR] = CR_GOLD;      break;
                    case 6: PDA_Local.heading = "PDA_BESTIARY_HEADER_SP";
                    beast_info[BEAST__LV_COLOR] = CR_PURPLE;    break;
                }
                break;
            case PDA_EQUIPMENT:
                PDA_Local.pageMax = 2;

                switch (PDA_Local.page) {
                    case EQUIPMENT_PAGE_ONHAND:
                        PDA_Local.heading = "PDA_ARMOR_HEADER1";
                        break;
                    case EQUIPMENT_PAGE_INFO:
                        PDA_Local.heading = "PDA_ARMOR_HEADER2";
                        break;
                }
                break;

            case PDA_ASSEMBLIES:
                PDA_Local.pageMax = 3;
                switch (PDA_Local.page) {
                    case ASSEMBLY_PAGE_BASIC:
                        PDA_Local.heading = "PDA_ASSEMBLY_BASIC_NAME";
                        break;
                    case ASSEMBLY_PAGE_ADVANCED:
                        PDA_Local.heading = "PDA_ASSEMBLY_ADVANCED_NAME";
                        break;
                    case ASSEMBLY_PAGE_MASTER:
                        PDA_Local.heading = "PDA_ASSEMBLY_MASTER_NAME";
                        break;
                }
                break;

            case PDA_HELP:
                PDA_Local.pageMax = 2;

                switch(PDA_Local.page) {
                    case 1: PDA_Local.heading = "PDA_PDAHELP_HEADER"; break;
                    case 2: PDA_Local.heading = "PDA_DRLAHELP_HEADER"; break;
                    case 3: PDA_Local.heading = "PDA_DMGHELP_HEADER"; break;
                }
                break;
            case PDA_MISC:
                PDA_Local.pageMax = 1;

                PDA_Local.heading = "PDA_MISC_HEADER";
                break;

            case PDA_ITEMS:
                break;
            case PDA_EQUIPMENT_DETAIL:
                PDA_Local.pageMax = 1;

                PDA_Local.heading = "PDA_DETAILEDARMOR_HEADER";
                break;
            case PDA_ASSEMBLY_DETAIL:
                PDA_Local.pageMax = 1;

                PDA_Local.heading = "PDA_DETAILEDASSEMBLY_HEADER";
                break;
            case PDA_BESTIARY_DETAIL:
                PDA_Local.pageMax = 1;

                PDA_Local.heading = "PDA_DETAILEDBEAST_HEADER";
                break;
            case PDA_CREDITS:
                PDA_Local.pageMax = 1;

                PDA_Local.heading = "PDA_CREDITS_HEADER";
        }
    }

    // Then print the header
    if (PDA_ScrollableNeedsDraw) {
        PDA_DefaultFont();
        PDA_DrawHeaderText(PDA_Local.heading, PDA_HEADING_X, PDA_SCREEN_Y + 6.0);
    }
    PDA_SetupScreenBounds();
    TraceLog("PDA_HandleHeader");
}


