function void HudMessageScrollable(str text, int type, int id, int color, fixed x, fixed y, fixed holdTime, fixed alpha) {
    HudMessage(s:text; type, id, color,
               (int)((PDA_SCREEN_X + x) * NEW_RESOLUTION_X) + X_LEFT_EDGE,
               (int)((y + PDA_Local.scrollingY) * NEW_RESOLUTION_Y) + Y_TOP_EDGE,
               holdTime, alpha);
    TraceLog("HudMessageScrollable");
}

function int CheckPointerInventory (str item, int pn) {
    SetActivator(0, AAPTR_PLAYER1 << pn);
    return CheckInventory(item);
}

function int SetInventory (str Item, int Count) {
    int n = Count - CheckInventory(Item);

    if (n > 0)
        GiveInventory(Item, n);
    else if (n < 0)
        TakeInventory(Item, -n);

    return n;
}

function int checkSpecialArmorTokens(void) {
    return CheckInventory("RLEnclaveSetBonusActive")                 ||
        CheckInventory("PowerRLPrototypeAssaultShieldProtection") ||
        CheckInventory("PowerRLOverchargeSystemProtection")       ||
        CheckInventory("RLCyberneticArmorModdedToken")            ||
        CheckInventory("RLDeathFromAboveSetBonusActive")          ||
        CheckInventory("PowerRLInquisitorsSetBonusProtection");
}

// Onto other stuff
// For assembly tooltips
function void PDA_SetupFloatingTooltip (str graphic, str tooltip) {
    // if (!PDA_ScrollableNeedsDraw) return;

    if (StrLen(graphic) == 0 || StrLen(tooltip) == 0) {
        HudMessage(s:" "; HUDMSG_ALPHA, PDA_TOOLTIPGFX, CR_UNTRANSLATED,
                   0.0, 0.0, INF_HOLDTIME, 0.0);
        HudMessage(s:" "; HUDMSG_ALPHA, PDA_TOOLTIPID, CR_UNTRANSLATED,
                   0.0, 0.0,INF_HOLDTIME, 0.0);
        PDA_SetupScreenBounds();
        return;
    }

    int _xTemp = (PDA_SCREEN_X_SCALED + PDA_SCREEN_WIDTH_SCALED) / 3;
    int _yTemp = (PDA_SCREEN_Y_SCALED + 32);

    SetFont(graphic);
    HudMessage(s:"A\n"; HUDMSG_ALPHA, PDA_TOOLTIPGFX, CR_UNTRANSLATED,
        _xTemp + X_LEFT_EDGE, _yTemp + Y_TOP_EDGE,
        INF_HOLDTIME, 0.9);

    SetFont(PDA_FONT[mono_font]);
    PDA_SetupFloatingTooltipBounds();

    #define textFromGraphicOffset 10.0
    HudMessage(s:tooltip; HUDMSG_ALPHA, PDA_TOOLTIPID, CR_UNTRANSLATED,
        (int)(_xTemp + textFromGraphicOffset) + X_LEFT_EDGE, (int)(_yTemp + textFromGraphicOffset) + Y_TOP_EDGE,
        INF_HOLDTIME, OPAQUE);
    PDA_SetupScreenBounds();
    TraceLog("PDA_SetupFloatingTooltip");
    // PDA_SetupScreenBounds();
}

// Setup scrolling arrows for pages with lots of text
function void PDA_SetScrollArrows (int scrollDownMax, int scrollUpMax) {
    bool notbot = PDA_Local.scrollingY > scrollDownMax;
    bool nottop = PDA_Local.scrollingY < scrollUpMax;

    DisplayIcon("RLZARU", PDA_SCROLLUPID, PDA_SCREEN_WIDTH_SCALED + X_LEFT_EDGE, (int)(PDA_BODY_Y + 12.0) + Y_TOP_EDGE, INF_HOLDTIME, (nottop) ? 0.5 : 0.0);

    DisplayIcon("RLZARD", PDA_SCROLLDNID, PDA_SCREEN_WIDTH_SCALED + X_LEFT_EDGE, (int)(PDA_SCREEN_HEIGHT_SCALED + PDA_HEADER_HEIGHT) + Y_BOTTOM_EDGE, INF_HOLDTIME, (notbot) ? 0.5 : 0.0);

    TraceLog("PDA_SetScrollArrows");
}

function PDA_EquipmentData clearEquipmentData (int i) {
    localEquipmentDataStored[i].type = -1;
    localEquipmentDataStored[i].buttonID = -1;
    localEquipmentDataStored[i].langEntry = "";
    localEquipmentDataStored[i].name = "";
    localEquipmentDataStored[i].graphic = "";
    localEquipmentDataStored[i].attr = "";
    localEquipmentDataStored[i].desc = "";
    localEquipmentDataStored[i].val = "";
    localEquipmentDataStored[i].tooltip = "";
    localEquipmentDataStored[i].res = "";

    return localEquipmentDataStored[i];
}

function PDA_EquipmentData setupArmorData (int specialArmorTokens, str langEntry) {
    #define armorActor DRLA_Equipment_List[localArmorIndex][armor_ACTOR]

    PDA_EquipmentData _armor;

    bool noLangEntry = (StrCmp(langEntry, "") == 0);
    // feels silly to check explicitly for true
    bool renegade_check = CheckActorClass(0, CheckInventory("DRPGDRLAActive") ? "DoomRLRenegadeRPG" : "DoomRLRenegade") == true;

    str _le = (noLangEntry ? StrParam("PDA_ARMOR_%s:", armorActor) : langEntry);

    if (specialArmorTokens) {
        if (noLangEntry) {
            if (CheckInventory("RLEnclaveSetBonusActive")) {
                _le = StrParam("PDA_ARMOR_%s:COMPLETE", armorActor);
                _armor.langEntry = _le;
            } else {
                _le = StrParam("PDA_ARMOR_BOOSTED_%s:", armorActor);
                _armor.langEntry = _le;
            }
        }
        _armor.langEntry = _le;
        _armor.res  = StrParam("%l:", StrParam("%l:_RES", _le));
    } else {
        // if (noLangEntry) {
        //     _le = StrParam("PDA_ARMOR_%s:", armorActor);
        // }
        _armor.langEntry = _le;
        _armor.res  = StrParam("%l:", StrParam("%l:_RES", _le));

        if (CheckInventory("PowerRLReactiveShieldSystemMelee"))
            _armor.res = "PDA_ARMOR_REACTIVESHIELDSYSTEM_MELEE";

        if (CheckInventory("PowerRLReactiveShieldSystemBullet"))
            _armor.res = "PDA_ARMOR_REACTIVESHIELDSYSTEM_BULLET";

        if (CheckInventory("PowerRLReactiveShieldSystemFire"))
            _armor.res = "PDA_ARMOR_REACTIVESHIELDSYSTEM_FIRE";

        if (CheckInventory("PowerRLReactiveShieldSystemPlasma"))
            _armor.res = "PDA_ARMOR_REACTIVESHIELDSYSTEM_PLASMA";
    }

    if (specialArmorTokens && stricmp(strLeft(DRLA_Equipment_List[localArmorIndex][armor_TOKEN], 17), "RLCyberneticArmor") == 0) {
        _armor.name    = StrParam("%l:", "PDA_ARMOR_CYBERNETICARMOR_NAME");
        _armor.graphic = StrParam("%l:", "PDA_ARMOR_CYBERNETICARMOR_ICON");
        _armor.attr    = StrParam("%l:", "PDA_ARMOR_CYBERNETICARMOR_ATTR");
        _armor.desc    = StrParam("%l:", "PDA_ARMOR_CYBERNETICARMOR_DESC");
        _armor.val     = StrParam("%l:\n\n", (!renegade_check) ? "PDA_ARMOR_CYBERNETICARMOR_PROT" : "PDA_ARMOR_CYBERNETICARMOR_RENPROT");

        if (CheckInventory("RLCyberneticArmorModdedToken")) {
            if (CheckInventory("RLCyberneticArmorBulkToken"))      _armor.res = "PDA_ARMOR_BOOSTED_CYBERNETICARMORBULK_RES";
            if (CheckInventory("RLCyberneticArmorPowerToken"))     _armor.res = "PDA_ARMOR_BOOSTED_CYBERNETICARMORPOWER_RES";
            if (CheckInventory("RLCyberneticArmorAgilityToken"))   _armor.res = "PDA_ARMOR_BOOSTED_CYBERNETICARMORAGILITY_RES";
            if (CheckInventory("RLCyberneticArmorTechnicalToken")) _armor.res = "PDA_ARMOR_BOOSTED_CYBERNETICARMORTECHNICAL_RES";
            if (CheckInventory("RLCyberneticArmorSniperToken"))    _armor.res = "PDA_ARMOR_BOOSTED_CYBERNETICARMORSNIPER_RES";
            if (CheckInventory("RLCyberneticArmorFirestormToken")) _armor.res = "PDA_ARMOR_BOOSTED_CYBERNETICARMORFIRESTORM_RES";
            if (CheckInventory("RLCyberneticArmorNanoToken"))      _armor.res = "PDA_ARMOR_BOOSTED_CYBERNETICARMORNANO_RES";
            if (CheckInventory("RLCyberneticArmorOnyxToken"))      _armor.res = "PDA_ARMOR_BOOSTED_CYBERNETICARMORONYX_RES";
        }

        _armor.tooltip   = StrParam("%l:\n%l:\n%l:", !renegade_check ? "PDA_ARMOR_CYBERNETICARMOR_PROT" : "PDA_ARMOR_CYBERNETICARMOR_RENPROT", _armor.res, _armor.attr);
    } else {
        _armor.name    = fetchEntry("%l:_NAME", _le);
        _armor.graphic = fetchEntry("%l:_ICON", _le);
        _armor.attr    = fetchEntry("%l:_ATTR", _le);
        _armor.desc    = fetchEntry("%l:_DESC", _le);
        _armor.val     = StrParam("%l:\n\n", (!renegade_check) ? StrParam("%l:_PROT", _le) : StrParam("%l:_RENPROT", _le));
        _armor.tooltip = StrParam(
            "\cdStats:\c-\n"
            "%l:\n"
            "%l:\n"
            "%l:",
            (!renegade_check) ? StrParam("%l:_PROT", _le)
            : StrParam("%l:_RENPROT", _le),
            _armor.res, _armor.attr
        );
    }
    _armor.type = EQUIPPED_WORN_ARMOR;
    TraceLog("setupArmorData");
    return _armor;
}

function PDA_EquipmentData setupBackpackData (void) {
    #define backpackIndex DRLA_BackpackList[localBackpackIndex][1]

    PDA_EquipmentData _backpack;
    _backpack.type    = EQUIPPED_WORN_BACKP;
    _backpack.name    = fetchEntry("PDA_BACKPACK_%s:_NAME", backpackIndex);
    _backpack.graphic = fetchEntry("PDA_BACKPACK_%s:_ICON", backpackIndex);
    _backpack.val     = fetchEntry("PDA_BACKPACK_%s:_DESC", backpackIndex);
    _backpack.tooltip = StrParam(
        s:"\cdDescription:\c-\n",
        l:_backpack.val
    );

    TraceLog("setupBackpackData");
    return _backpack;
}

// theoretically i could merge these three setup functions into one but eh

function PDA_EquipmentData setupBootsData (str langEntry) {
    #define bootsActor DRLA_Equipment_List[localBootsIndex][armor_ACTOR]

    PDA_EquipmentData _boots;

    str _le = (StrLen(langEntry) == 0) ? StrParam("PDA_ARMOR_%s:", bootsActor) : langEntry;

    // GENERICARMOR - aka the default 'null' option, can be technically picked up in the test map, but..
    // We shouldn't display it, maybe we can return a sort of "error" display instead?
    // Tis a mystery..

    // TODO: Create unknown equipment icon

    // if (stricmp(bootsActor, "GENERIC") != 0 && stricmp(langEntry, "GENERIC") != 0) {
    if (str_find(bootsActor, "GENERIC", 0) != -1 && str_find(langEntry, "GENERIC", 0) != -1) {
        _boots.langEntry = "";
        _boots.val       = "";
        _boots.graphic   = "PDAUNK";
        _boots.name      = StrParam(l:"PDA_ASSEMBLY_UNKNOWN");
        _boots.attr      = "";
        _boots.desc      = "";
        _boots.tooltip   = StrParam(
            "\cgERROR:\c-\n"
            "Equipment unknown!"
        );
    } else {
        _boots.langEntry = _le;
        _boots.val       = StrParam("%l:\n\n", StrParam("%l:_PROT", CheckInventory("RLEnclaveSetBonusActive") ? StrParam("PDA_ARMOR_BOOSTED_%s:", bootsActor) : _le));
        _boots.name      = fetchEntry("%l:_NAME", _le);
        _boots.graphic   = fetchEntry("%l:_ICON", _le);
        _boots.attr      = fetchEntry("%l:_ATTR", _le);
        _boots.desc      = fetchEntry("%l:_DESC", _le);
        _boots.tooltip   = StrParam(
            "\cdStats:\c-\n"
            "%l:\n\n"
            "%l:",
            StrParam("%l:_PROT", _le),
            _boots.attr
        );
    }
    _boots.type = EQUIPPED_WORN_BOOTS;

    TraceLog("setupBootsData");

    return _boots;
}

function void PDA_SetDataPerPage (void) {
    switch (PDA_Local.category) {
        case PDA_MENU:
            break;

        case PDA_CLASSES:
            int PDA_Class_TrimValue = CheckInventory("DRPGDRLAActive") ? 3 : 0;

            PDA_LocalClass[pda_class_name]      = StrParam("PDA_CLASS_%s:_NAME"     , StrTrim(GetActorClass(0),0,PDA_Class_TrimValue));
            PDA_LocalClass[pda_class_abilities] = StrParam("PDA_CLASS_%s:_ABILITIES", StrTrim(GetActorClass(0),0,PDA_Class_TrimValue));
            PDA_LocalClass[pda_class_story]     = StrParam("PDA_CLASS_%s:_STORY"    , StrTrim(GetActorClass(0),0,PDA_Class_TrimValue));
            PDA_LocalClass[pda_class_height]    = StrParam("PDA_CLASS_%s:_HEIGHT"   , StrTrim(GetActorClass(0),0,PDA_Class_TrimValue));
            PDA_LocalClass[pda_class_icon]      = StrParam("%l:", StrParam("PDA_CLASS_%s:_ICON", StrTrim(GetActorClass(0),0,PDA_Class_TrimValue)));
            break;

        case PDA_WEAPONS:
            player_weapon[player_weapon_current] = GetWeapon();
            player_weapon[player_weapon_trimmed] = StrTrim(player_weapon[player_weapon_current], 2, 0);

            weapon_checks[weapon_checks_disassemblable] = (GetActorClass(0) == "DoomRLTechnician" && !CheckInventory("RLStandardWeaponToken"));
            weapon_checks[weapon_checks_supports_artifacts] = CheckInventory(StrParam("%s:DemonArtifacts", player_weapon[player_weapon_current]));

            setMaxModLimit();

            checkPlayerWeaponPerk();
            checkWeaponArmorSetPerk();

            if (stricmp(player_weapon[player_weapon_current], "None") != 0) {
                weapon_info[weapon_info_icon]     = StrParam("PDA_WEAPON_%s:_ICON", player_weapon[player_weapon_trimmed]);
                weapon_info[weapon_info_desc]     = StrParam("PDA_WEAPON_%s:_DESC", player_weapon[player_weapon_trimmed]);
                weapon_info[weapon_info_dualdesc] = StrParam("PDA_WEAPON_%s:DEMONARTIFACTS_DESC", player_weapon[player_weapon_trimmed]);

                str_split(separator_character, StrParam("%l:", StrParam("PDA_WEAPON_%s:_MODS", player_weapon[player_weapon_trimmed])), MODS_DIM);
            }
            break;

        case PDA_BESTIARY:
            break;
        case PDA_EQUIPMENT:
            // bool specialArmorTokens   = checkSpecialArmorTokens();
            // localEquipmentDataStored[EQUIPPED_WORN_ARMOR] = setupArmorData(specialArmorTokens, "");
            // localEquipmentDataStored[EQUIPPED_WORN_BOOTS] = setupBootsData("");
            // localEquipmentDataStored[EQUIPPED_WORN_BACKP ]= setupBackpackData();
            // bool isRenegade = (CheckActorClass(0, CheckInventory("DRPGDRLAActive") ? "DoomRLRenegadeRPG" : "DoomRLRenegade") == true);
            switch (PDA_Local.page) {
                case EQUIPMENT_PAGE_ONHAND:
                    break;
                case EQUIPMENT_PAGE_INFO:
                    // No point to this in the detail info, I guess
                    // localEquipmentDataStored[EQUIPPED_WORN_ARMOR].tooltip = "";
                    // localEquipmentDataStored[EQUIPPED_WORN_BOOTS].tooltip = "";
                    // localEquipmentDataStored[EQUIPPED_WORN_BACKP].tooltip = "";

                    // localShowArmor    = (localEqBoolField & 1);
                    // localShowBoots    = (localEqBoolField & 1<<1);
                    // localShowBackpack = (localEqBoolField & 1<<2);
                    break;
            }
            break;

        case PDA_ASSEMBLIES:
            switch (PDA_Local.page) {
                case ASSEMBLY_PAGE_BASIC:
                    PDA_Local.maxAssembliesPer = (advanced_offset - 1);
                    PDA_Local.assemblyOffset   = basic_offset;
                    PDA_Local.tierColor        = "\c[BB]";
                    break;
                case ASSEMBLY_PAGE_ADVANCED:
                    PDA_Local.maxAssembliesPer = (master_offset - 1) - advanced_offset;
                    PDA_Local.assemblyOffset   = advanced_offset;
                    PDA_Local.tierColor        = "\c[AB]";
                    break;
                case ASSEMBLY_PAGE_MASTER:
                    PDA_Local.maxAssembliesPer = master_max - master_offset;
                    PDA_Local.assemblyOffset   = master_offset;
                    PDA_Local.tierColor        = "\c[MB]";
                    break;
                default:
                    Print(s:"how da fuk");
                    break;
            }
            break;

        case PDA_HELP:
            break;
        case PDA_MISC:
            break;

        case PDA_ITEMS:
            if (GetCvar("DRLA_specialstarts") != 2)
            {
                PDA_Local.pageMax = DRLA_GROUPQUANTITY;
            }
            break;
        case PDA_ASSEMBLY_DETAIL:
            if (stricmp(PDA_Local.detailFetch[0], "null") != 0) {
                PDA_AssemblyInfo[PlayerNumber()][0] = StrParam("%s:_ICON",   PDA_Local.detailFetch[0]);
                PDA_AssemblyInfo[PlayerNumber()][1] = StrParam("%s:_NAME",   PDA_Local.detailFetch[0]);
                PDA_AssemblyInfo[PlayerNumber()][2] = StrParam("%s:_MODS",   PDA_Local.detailFetch[0]);
                PDA_AssemblyInfo[PlayerNumber()][3] = StrParam("%s:_DESC",   PDA_Local.detailFetch[0]);
                PDA_AssemblyInfo[PlayerNumber()][4] = StrParam("%s:_HEIGHT", PDA_Local.detailFetch[0]);
            }
            break;
        case PDA_BESTIARY_DETAIL:
            if (stricmp(PDA_Local.detailFetch[0], "null") != 0) {
                beast_info[BEAST__E_COUNT]                                 = PDA_Local.detailFetch[1];
                PDA_Enemy[PlayerNumber()][enemy_name]       = StrParam("%s:_NAME",       PDA_Local.detailFetch[0]);
                PDA_Enemy[PlayerNumber()][enemy_icon]       = StrParam("%s:_ICON",       PDA_Local.detailFetch[0]);
                PDA_Enemy[PlayerNumber()][enemy_health]     = StrParam("%s:_HEALTH",     PDA_Local.detailFetch[0]);
                PDA_Enemy[PlayerNumber()][enemy_resistance] = StrParam("%s:_RESISTANCE", PDA_Local.detailFetch[0]);
                PDA_Enemy[PlayerNumber()][enemy_misc]       = StrParam("%s:_MISC",       PDA_Local.detailFetch[0]);
            }
            break;
        case PDA_CREDITS:
            break;
    }
    TraceLog("PDA_SetDataPerPage");
}

function void PDA_ChangeScrolling (void) {
    switch (PDA_Local.category) {
        case PDA_MENU:
            PDA_SetScrollWindow(-25, PDA_SCROLL_TOP);
            break;

        case PDA_CLASSES:
            switch (PDA_Local.page) {
                case CLASSES_PAGE_PERKS:
                    PDA_SetScrollWindow(PDA_SCROLL_TOP, PDA_SCROLL_TOP);
                    break;
                case CLASSES_PAGE_STORY:
                    PDA_SetScrollWindow(
                        PDA_CreateScrollHeight(PDA_LocalClass[pda_class_height]),
                        PDA_SCROLL_TOP
                    );
                    break;
            }
            break;

        case PDA_WEAPONS:
            switch (PDA_Local.page) {
                case WEAPON_PAGE_STORY:
                    PDA_SetScrollWindow(-50, PDA_SCROLL_TOP);
                    break;
                case WEAPON_PAGE_MODPACK_EFFECTS:
                    PDA_SetScrollWindow(-60, PDA_SCROLL_TOP);
                    break;
                case WEAPON_PAGE_ARTIFACT_EFFECTS:
                    PDA_SetScrollWindow(-80, PDA_SCROLL_TOP);
                    break;
            }
            break;

        case PDA_BESTIARY:
            PDA_SetScrollWindow(-240, PDA_SCROLL_TOP);
            // PDA_SetScrollWindow(-240, PDA_SCROLL_TOP);

            switch (PDA_Local.page) {
                case BESTIARY_PAGE_DIFFICULTIES:
                    PDA_SetScrollWindow(20, PDA_SCROLL_TOP);
                    break;
                default:
                    PDA_SetScrollWindow(DRLA_MONSTER_PAGE_MAX * -10, PDA_SCROLL_TOP);
                    break;
            }
            break;
        case PDA_BESTIARY_DETAIL:
            PDA_SetScrollWindow((stricmp(PDA_Local.detailFetch[0], "null") != 0 ? -100 : 0), PDA_SCROLL_TOP)
            break;

        case PDA_EQUIPMENT:
            switch (PDA_Local.page) {
                case EQUIPMENT_PAGE_ONHAND:
                    if (!PDA_Local.hasEquipment) {
                        // If blank
                        PDA_SetScrollWindow(40, PDA_SCROLL_TOP);
                    } else {
                        // If there's actual equipment
                        PDA_SetScrollWindow(-40, PDA_SCROLL_TOP);
                    }
                    break;
                case EQUIPMENT_PAGE_INFO:
                    PDA_SetScrollWindow(-160, PDA_SCROLL_TOP);
                    break;
            }
            break;
        case PDA_EQUIPMENT_DETAIL:
            PDA_SetScrollWindow(-80, PDA_SCROLL_TOP);
            break;

        case PDA_ASSEMBLIES:
            switch (PDA_Local.page) {
                case ASSEMBLY_PAGE_BASIC:
                    PDA_SetScrollWindow((int)(-2 * advanced_offset - 1), PDA_SCROLL_TOP);
                    break;
                case ASSEMBLY_PAGE_ADVANCED:
                    PDA_SetScrollWindow((int)(-1 * (master_offset - 1) - advanced_offset), PDA_SCROLL_TOP);
                    break;
                case ASSEMBLY_PAGE_MASTER:
                    PDA_SetScrollWindow((int)(-1 * master_max - master_offset), PDA_SCROLL_TOP);
                    break;
            }
            // PDA_SetScrollWindow((int)(-6 * PDA_Local.maxAssembliesPer), PDA_SCROLL_TOP);
            break;
        case PDA_ASSEMBLY_DETAIL:
            PDA_SetScrollWindow(-100, PDA_SCROLL_TOP);
            break;

        case PDA_HELP:
            PDA_SetScrollWindow(-100, PDA_SCROLL_TOP);
            break;
        case PDA_MISC:
            PDA_SetScrollWindow(0, PDA_SCROLL_TOP);
            break;

        case PDA_ITEMS:
            PDA_SetScrollWindow(-200, PDA_SCROLL_TOP);
            break;
        case PDA_CREDITS:
            PDA_SetScrollWindow(0, PDA_SCROLL_TOP);
            // PDA_SetScrollWindow(0, PDA_SCROLL_TOP);
            break;
    }
    PDA_SetFullDirty();
    TraceLog("PDA_ChangeScrolling");
}

function void PDA_SetCategory (int category) {
    afterPageDefaults("PDA_SetCategory start");
    if (PDA_Local.category == category) {
        return;
    }

    if (category == PDA_CREDITS) {
        PDA_Local.creditsroll = 120;
    }

    if (PDA_Local.category == PDA_PONG) {
        PDA_NOPONG();
        PDA_Local.pongRunning = false;
    }

    PDA_Local.textY = 0.0;
    // PDA_Local.scrollingY = PDA_SCREEN_Y;
    PDA_ResetScroll();
    PDA_Local.category = category;
    afterPageDefaults("PDA_SetCategory end");
    TraceLog("PDA_SetCategory");
}

function void PDA_SetPage (int page_num) {
    PDA_Local.prevPage = PDA_Local.page;
    PDA_Local.page = page_num;
    // PDA_SetFullDirty(); // This is already handled by PDA_OnChange, I believe
    afterPageDefaults("PDA_SetPage");
    TraceLog("PDA_SetPage");
}

// Initial spike on PDA load. Perhaps this could be made to happen at some other point..?
function void PDA_HasEquipment (void) {
    // Anytime we reserve an ID for the button, we also have to reserve one for the tooltip..
    // Consider that PDA_WORN_EQUIPMENT_END starts at PDA_ASSEMBLY_ID_END + (3*4), we can then snag the IDs backwards instead of forwards

    bool specialArmorTokens = checkSpecialArmorTokens();

    // Lazy clean the arrays first. May not be necessary.
    for (int i = 0; i < PDA_EQUIPMENT_TOTAL_MAX; i++) {
        clearEquipmentData(i);
    }

    // Normal
    int eqId = 0;
    int stshId = EQUIPPED_WORN_BOOTS + 1;

    #define equipmentSet(a) \
        PDA_Local.equipmentId[a] = (PDA_WORN_EQUIPMENT_END - (a * 2));

    PDA_Local.hasEquipment = false;

    for (int bp_i = 0; bp_i < DRLA_BACKPACKMAX; bp_i++) {
        if (CheckInventory(DRLA_BackpackList[bp_i][0])) {
            clearEquipmentData(EQUIPPED_WORN_BACKP);
            eqId = EQUIPPED_WORN_BACKP;
            localBackpackIndex = bp_i;
            localHasEquippedBackpack = true;

            equipmentSet(eqId);

            localEquipmentDataStored[EQUIPPED_WORN_BACKP] = setupBackpackData();
            PDA_Local.hasEquipment = true;
        } else if (!CheckInventory(DRLA_BackpackList[localBackpackIndex][0])) {
            clearEquipmentData(EQUIPPED_WORN_BACKP);
            localHasEquippedBackpack = false;
        }
    }

    for (int equipmentIndex = 0; equipmentIndex < DRLA_EQUIPMENT_MAX; equipmentIndex++) {
        #define _equipmentToken DRLA_Equipment_List[equipmentIndex][armor_TOKEN]

        #define equipmentIsBoots \
            StrCmp(_equipmentToken, StrParam("%s:Boots", StrTrim(_equipmentToken,0,5))) == 0

        // Tokens are used if the character is wearing armor
        if (CheckInventory(StrParam("%s:Token", _equipmentToken))) {
            if (StrCmp(
                _equipmentToken,
                StrParam("%s:Boots", StrTrim(_equipmentToken,0,5))
            ) != 0) {
                clearEquipmentData(EQUIPPED_WORN_ARMOR);
                eqId = EQUIPPED_WORN_ARMOR;
                localArmorIndex = equipmentIndex;
                localHasEquippedArmor = true;

                equipmentSet(eqId);

                localEquipmentDataStored[EQUIPPED_WORN_ARMOR] = setupArmorData(specialArmorTokens, "");
                PDA_Local.hasEquipment = true;
            } else {
                clearEquipmentData(EQUIPPED_WORN_BOOTS);
                eqId = EQUIPPED_WORN_BOOTS;
                localBootsIndex = equipmentIndex;
                localHasEquippedBoots = true;

                equipmentSet(eqId);

                localEquipmentDataStored[EQUIPPED_WORN_BOOTS] = setupBootsData("");
                PDA_Local.hasEquipment = true;
            }
        }
        // Do another check then, if it turns out these tokens are missing..
        if (!CheckInventory(StrParam("%s:Token", DRLA_Equipment_List[localArmorIndex][armor_TOKEN]))) {
            localArmorIndex = 0;
            localHasEquippedArmor = false;
            clearEquipmentData(EQUIPPED_WORN_ARMOR);
            localEquipmentDataStored[EQUIPPED_WORN_ARMOR].langEntry = "X";
            localEquipmentDataStored[EQUIPPED_WORN_ARMOR].name = "X";
        }
        if (!CheckInventory(StrParam("%s:Token", DRLA_Equipment_List[localBootsIndex][armor_TOKEN]))) {
            localBootsIndex = 0;
            localHasEquippedBoots = false;
            clearEquipmentData(EQUIPPED_WORN_BOOTS);
            localEquipmentDataStored[EQUIPPED_WORN_BOOTS].langEntry = "X";
            localEquipmentDataStored[EQUIPPED_WORN_BOOTS].name = "X";
        }

        // Otherwise, pickups in inventory
        #define _equipmentActor DRLA_Equipment_List[equipmentIndex][armor_ACTOR]

        #define stashedSet(stshId) \
            PDA_Local.equipmentId[stshId] = (PDA_STASHEDEQUIPMENT_END - (stshId * 2));

        if (CheckInventory(StrParam("%s:Pickup", _equipmentToken))) {
            clearEquipmentData(stshId);
            stashedSet(stshId);

            if (!equipmentIsBoots) {
                localEquipmentDataStored[stshId] = setupArmorData(specialArmorTokens, StrParam("PDA_ARMOR_%s:", _equipmentActor));
                localEquipmentDataStored[stshId].tooltip = StrParam(
                    "\cdStats:\c-\n"
                    "%l:\n" // 1*
                    "%l:\n" // 2*
                    "%l:", // 3*
                    (!isRenegade
                        ? StrParam("%l:_PROT", localEquipmentDataStored[stshId].langEntry)
                        : StrParam("%l:_RENPROT", localEquipmentDataStored[stshId].langEntry)
                    ), // 1
                    StrParam("%l:_RES", localEquipmentDataStored[stshId].langEntry),  // 2
                    localEquipmentDataStored[stshId].attr // 3
                );
            } else {
                localEquipmentDataStored[stshId] = setupBootsData(StrParam("PDA_ARMOR_%s:", _equipmentActor));
                localEquipmentDataStored[stshId].tooltip = StrParam(
                    "\cdStats:\c-\n"
                    "%l:\n\n" // 1*
                    "%l:", // 2*
                    StrParam("%l:_PROT", localEquipmentDataStored[stshId].langEntry), // 1
                        localEquipmentDataStored[stshId].attr // 2
                );
            }
            localEquipmentDataStored[stshId].buttonID = PDA_Local.equipmentId[stshId];

            if (stshId < PDA_EQUIPMENT_TOTAL_MAX) stshId++;
            PDA_Local.hasEquipment = true;
        }
    }

    TraceLog("PDA_HasEquipment");
}

// ENTER YE BUTTON CREATION


/**
* @name: Create PDA Menu button
* @param: int id  The ID of the button
* @param: str label  The button's label that's displayed
* @param: str graphic  The graphic used
* @param: fixed x  Button X co-ordinate
* @param: fixed y  Button Y co-ordinate
* @param: int width  Button width
* @param: int height  Button height
*/

function PDAButton PDA_CreateMenuButton (int id, int page, str graphic, fixed x, fixed y) {
    #define thisButton PDA_LocalButton[id]
    int width  = PDA_MENU_BTN_W;
    int height = PDA_MENU_BTN_H;

    assignButtonParams(thisButton, "")

    thisButton.type         = "menu";
    thisButton.graphic      = graphic;
    thisButton.graphicFlags = HUDMSG_ALPHA;
    thisButton.graphicID    = thisButton.id;

    thisButton.actionID     = action_navigate;
    thisButton.actionParam  = page;

    assignButtonPosition(thisButton.gfxPos,
        (int)(thisButton.x * NEW_RESOLUTION_X),
        (int)(thisButton.y * NEW_RESOLUTION_Y),
        0.0,
        0.0
    );
    thisButton.textFont     = PDA_FONT[slim_font];
    thisButton.textFlags    = HUDMSG_ALPHA;
    thisButton.textID       = thisButton.graphicID + 1;
    assignButtonPosition(thisButton.textPos,
        thisButton.gfxPos[TB_X],
        (int)(thisButton.y * NEW_RESOLUTION_Y),
        0.0,
        0.0
    );

    TraceLog("PDA_CreateMenuButton");
    return thisButton;
}

function PDAButton PDA_CreateTab (int id, str label, int page, str graphic, fixed x) {
    #define thisButton PDA_LocalButton[id]
    int y      = PDA_TAB_Y;
    int width  = PDA_TAB_W;
    int height = PDA_TAB_H;
    assignButtonParams(thisButton, label)

    thisButton.y     = PDA_SCREEN_Y + y; // Override as this isn't meant to scroll
    thisButton.alpha = DEFAULT_BUTTON_ALPHA;

    thisButton.type          = "tab";
    thisButton.graphic       = graphic;
    thisButton.graphicFlags  = HUDMSG_ALPHA;
    thisButton.graphicID     = thisButton.id;
    assignButtonPosition(thisButton.gfxPos,
        (int)(thisButton.x * NEW_RESOLUTION_X),
        (int)(thisButton.y * NEW_RESOLUTION_Y),
        0.0,
        0.0
    );
    thisButton.textFont      = PDA_FONT[slim_font];
    thisButton.textFlags     = HUDMSG_ALPHA;
    thisButton.textID        = thisButton.graphicID + 1;
    assignButtonPosition(thisButton.textPos,
        (int)(thisButton.gfxPos[TB_X]) + 4.0,
        (int)(thisButton.gfxPos[TB_Y]) + 4.0,
        0.0,
        0.0
    );

    thisButton.actionID    = action_navigate;
    thisButton.actionParam = page;

    TraceLog("PDA_CreateTab");
    return thisButton;
}

function PDAButton PDA_CreateButton (int id, str label, str graphic, fixed x, fixed y, int width, int height, fixed gw, fixed gh) {
    #define thisButton PDA_LocalButton[id]
    assignButtonParams(thisButton, label)

    const fixed X_MARGIN = 1.0;

    thisButton.type         = "generic";
    thisButton.graphic      = graphic;
    thisButton.graphicFlags = HUDMSG_ALPHA;
    thisButton.graphicID    = thisButton.id;
    // assignButtonPosition(thisButton.gfxPos,
    //     (int)(thisButton.x * NEW_RESOLUTION_X),
    //     (int)(PDA_SCREEN_Y + (thisButton.y * NEW_RESOLUTION_Y) - (gh / 2)),
    //     0.0,
    //     0.0
    // );
    assignButtonPosition(thisButton.gfxPos,
        (int)(thisButton.x * NEW_RESOLUTION_X),
        (int)(thisButton.y * NEW_RESOLUTION_Y),
        0.0,
        0.0
    );
    thisButton.textFont  = PDA_FONT[slim_font];
    thisButton.textFlags = HUDMSG_ALPHA;
    thisButton.textID    = thisButton.graphicID + 20;
    assignButtonPosition(thisButton.textPos,
        (int)(thisButton.gfxPos[TB_X] + (gw + X_MARGIN) * NEW_RESOLUTION_X),
        (int)(thisButton.gfxPos[TB_Y] + 6.0),
        0.0,
        0.0
    );
    // assignButtonPosition(thisButton.textPos,
    //     (int)((int)thisButton.gfxPos[TB_X] + (gw + X_MARGIN) * NEW_RESOLUTION_X),
    //     (int)(thisButton.gfxPos[TB_Y]),
    //     0.0,
    //     0.0
    // );

    TraceLog("PDA_CreateButton");
    return thisButton;
}

// May not be used later on
function PDAButton PDA_CreateFixedButton (int id, str label, str graphic, fixed x, fixed y, int width, int height, fixed gw, fixed gh) {
    #define thisButton PDA_LocalButton[id]
    assignButtonParams(thisButton, label)
    thisButton.y = y;

    const fixed X_MARGIN = 1.0;

    thisButton.type         = "fixed";
    thisButton.graphic      = graphic;
    thisButton.graphicFlags = HUDMSG_ALPHA;
    thisButton.graphicID    = thisButton.id;
    assignButtonPosition(thisButton.gfxPos,
        (int)(thisButton.x * NEW_RESOLUTION_X),
        (int)(PDA_SCREEN_Y + (thisButton.y * NEW_RESOLUTION_Y) - (gh / 2)),
        0.0,
        0.0
    );
    thisButton.textFont  = PDA_FONT[slim_font];
    thisButton.textFlags = HUDMSG_ALPHA;
    thisButton.textID    = thisButton.graphicID + 20;
    assignButtonPosition(thisButton.textPos,
        (int)((int)thisButton.gfxPos[TB_X] + (gw + X_MARGIN) * NEW_RESOLUTION_X),
        thisButton.gfxPos[TB_Y],
        0.0,
        0.0
    );

    TraceLog("PDA_CreateFixedButton");
    return thisButton;
}

function PDAButton PDA_CreateAssemblyButton (int id, str graphic, str label, fixed x, fixed y, int width, int height, str assembly, str tooltip) {
    #define thisButton PDA_LocalButton[id]
    assignButtonParams(thisButton, label)

    const int X_MARGIN = 24;

    thisButton.type         = "assembly";
    thisButton.graphic      = graphic;
    thisButton.graphicFlags = HUDMSG_ALPHA;
    thisButton.graphicID    = thisButton.id;
    assignButtonPosition(thisButton.gfxPos,
        (int)(thisButton.x * NEW_RESOLUTION_X),
        (int)((thisButton.y + 5.0) * NEW_RESOLUTION_Y),
        0.0,
        20.0
    );
    thisButton.textFont  = PDA_FONT[mono_font];
    thisButton.textFlags = HUDMSG_ALPHA;
    thisButton.textID    = thisButton.id + 1;
    assignButtonPosition(thisButton.textPos,
        (int)(thisButton.gfxPos[TB_X] + X_MARGIN),
        (int)((thisButton.y + 0.0) * NEW_RESOLUTION_Y),
        0.0,
        0.0
    );

    thisButton.tooltip = tooltip;
    thisButton.actionID = action_open_assembly;
    thisButton.actionParam = PDA_ASSEMBLY_DETAIL;
    if (assembly) PDA_Local.detailFetch[0] = assembly;
    // if (CheckBounds(thisButton)) {
    //     if (PDA_LocalMouse.m1 && !(PDA_LocalMouse.oldState & _ACTION)) {
    //         if (assembly) PDA_Local.detailFetch[0] = assembly;
    //
    //         if (StrCmp(PDA_Local.detailFetch[0], "") != 0 ) {
    //             PDA_SetCategory(PDA_ASSEMBLY_DETAIL);
    //         }
    //     }
    //
    //     // Open tooltip
    //     // if (StrCmp(thisButton.tooltip, "") != 0 && StrCmp(assembly, "") != 0) {
    //     //     PDA_SetupFloatingTooltip("PTIPM", thisButton.tooltip);
    //     // }
    // }

    if (debug) {
        // DrawBorder(thisButton.x * NEW_RESOLUTION_X, thisButton.y * NEW_RESOLUTION_Y, width * NEW_RESOLUTION_X, height * NEW_RESOLUTION_Y);
    }
    TraceLog("PDA_CreateAssemblyButton");
    return thisButton;
}

function PDAButton PDA_CreateBeastButton (int id, str label, int color, fixed x, fixed y, int width, int height, fixed xoff, fixed yoff, str beast, str unatcokillphrase) {
    #define thisButton PDA_LocalButton[id]
    assignButtonParams(thisButton, label)
    thisButton.graphic = "";

    if (CheckBounds(thisButton)) {
        if (PDA_LocalMouse.m1 && !(PDA_LocalMouse.oldState & _ACTION)) {
            if (StrCmp(beast, "") != 0 && PDA_Local.page < 6) {
                PDA_Local.detailFetch[0] = beast;
                PDA_Local.detailFetch[1] = unatcokillphrase;

                PDA_SetCategory(PDA_BESTIARY_DETAIL);
            }
        }
    }

    thisButton.actionID = action_navigate;
    thisButton.actionParam = -1;
    thisButton.alpha = (thisButton.state == button_hovered) ? 1 : 0.6;

    thisButton.type         = "beast";
    thisButton.graphic      = "PLON";
    thisButton.graphicFlags = HUDMSG_ALPHA;
    thisButton.graphicID    = thisButton.id;
    assignButtonPosition(thisButton.gfxPos,
        (int)(thisButton.x * NEW_RESOLUTION_X),
        (int)(thisButton.y * NEW_RESOLUTION_Y),
        5.0,
        0.0
    );
    thisButton.textFont  = PDA_FONT[mono_font];
    thisButton.textFlags = HUDMSG_ALPHA | HUDMSG_COLORSTRING;
    thisButton.textColor = color;
    thisButton.textID    = (thisButton.id) + 20;
    assignButtonPosition(thisButton.textPos,
        (int)(thisButton.x * NEW_RESOLUTION_X) + 10.0,
        (int)(thisButton.y * NEW_RESOLUTION_Y) + 2.0,
        0.0,
        0.0
    );

    TraceLog("PDA_CreateBeastButton");
    return thisButton;
}

function PDAButton PDA_CreateHUDButton (int id, str label, str color, fixed x, fixed y, int width, int height, fixed xoff, fixed yoff, str chosenhud) {
    #define thisButton PDA_LocalButton[id]
    assignButtonParams(thisButton, label)

    thisButton.alpha = (thisButton.state == button_hovered) ? 1 : 0.6;

    thisButton.type         = "hud";
    thisButton.graphic      = "PLON";
    thisButton.graphicFlags = HUDMSG_ALPHA;
    thisButton.graphicID    = thisButton.id;
    assignButtonPosition(thisButton.gfxPos,
        (int)(thisButton.x * NEW_RESOLUTION_X),
        (int)(thisButton.y * NEW_RESOLUTION_Y),
        5.0,
        0.0
    );
    thisButton.textFont  = PDA_FONT[mono_font];
    thisButton.textFlags = HUDMSG_ALPHA | HUDMSG_COLORSTRING;
    thisButton.textID    = (thisButton.id) + 20;
    assignButtonPosition(thisButton.textPos,
        (int)(thisButton.x * NEW_RESOLUTION_X) + 10.0,
        (int)(thisButton.y * NEW_RESOLUTION_Y) + 4.0,
        0.0,
        0.0
    );

    TraceLog("PDA_CreateHUDButton");
    return thisButton;
}

// extracts from right to left
function int extractDigit (int number, int digit) {
    if (number < 10) return number;

    int copy = number;
    int result = 0;

    for (int attempts = 0; attempts < digit; ++attempts) {
        result = copy % 10;
        copy = copy / 10;
    }
    return result;
}

function PDAButton PDA_DisplayArmor (int id, int structType, int storedIndex, fixed x, fixed y, int height) {
    #define thisButton PDA_LocalButton[id]
    #define onEquipmentListing (PDA_Local.page == EQUIPMENT_PAGE_ONHAND)
    #define leDS localEquipmentDataStored[storedIndex]

    str label        = leDS.name;
    int actionID     = action_none;
    int actionParam  = -1;
    int width        = StrLen(leDS.name) * 5;

    // Prefix only for Equipment first page
    if (PDA_Local.category == PDA_EQUIPMENT && PDA_Local.page == 1 && (storedIndex == 1 || storedIndex == 2 || storedIndex == 3)) {
        label = StrParam("E: %s:", label);
    }

    bool specialArmorTokens   = checkSpecialArmorTokens();
    int specialIntShenanigans = 0;

    switch (structType) {
        case ARMOR_DATA:
            specialIntShenanigans = (10 + storedIndex);
            actionParam           = onEquipmentListing ? specialIntShenanigans : 1;
            break;
        case BACKPACK_DATA:
            specialIntShenanigans = (20 + storedIndex);
            actionParam           = onEquipmentListing ? specialIntShenanigans : 2;
            break;
        case BOOTS_DATA:
            specialIntShenanigans = (30 + storedIndex);
            actionParam           = onEquipmentListing ? specialIntShenanigans : 3;
            break;
    }
    assignButtonParams(thisButton, label)

    thisButton.graphic      = leDS.graphic;
    thisButton.tooltip      = StrParam("%s:\n%s:", leDS.name, leDS.tooltip);

    thisButton.type         = "equipment";
    thisButton.graphicFlags = HUDMSG_ALPHA;
    thisButton.graphicID    = thisButton.id;
    assignButtonPosition(thisButton.gfxPos,
        (int)(thisButton.x * NEW_RESOLUTION_X),
        (int)(thisButton.y * NEW_RESOLUTION_Y),
        -5.0,
        0.0
    );
    thisButton.textFont  = PDA_FONT[lower_font];
    thisButton.textFlags = HUDMSG_ALPHA;
    thisButton.textID    = (thisButton.id) + 1;
    assignButtonPosition(thisButton.textPos,
        (int)((thisButton.x + 35.0) * NEW_RESOLUTION_X),
        (int)(thisButton.y * NEW_RESOLUTION_Y) + (height / 2),
        0.0,
        0.0
    );

    thisButton.actionParam = actionParam;
    thisButton.actionID    = onEquipmentListing ? action_show_equipment_detail : action_toggle_display;
    // Declaring alpha here has no effect for this particular button.
    // thisButton.alpha       = alpha;

    TraceLog("PDA_DisplayArmor");
    return thisButton;
}



function PDAButton PDA_CreateModPackDisplay (int id, str graphic, fixed x, fixed y, int width, int height, fixed alpha) {
    #define thisButton PDA_LocalButton[id]
