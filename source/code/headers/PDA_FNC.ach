function void PDA_ButtonLogic (int id, int inCategory, int categoryPage, bool onlyVisual) {
    #define buttonType PDA_LocalButton[id].type

    if (buttonType == "tab") {
        PDA_SetupHeaderBounds();

        if (inCategory > 0 && PDA_Local.page == categoryPage) {
            // I wonder why I did this..
            PDA_LocalButton[id].state = button_hovered;
            PDA_LocalButton[id].alpha = 1;
        }
    }

    if (!onlyVisual) {
        buttonBoundsDefault(PDA_LocalButton[id]);

        if (PDA_LocalButton[id].state != PDA_LocalButton[id].oldState) {
            PDA_SetFullDirty();
        }

        switch (PDA_LocalButton[id].state) {
            case button_clicked:
                log("in cat? %b:", inCategory);
                if (!inCategory) {
                    log("catpage: %d:", categoryPage);
                    if (buttonType != "armor") PDA_SetCategory(categoryPage);

                    if (PDA_Local.category != PDA_ASSEMBLY_DETAIL) {
                        if (buttonType != "armor") PDA_SetPage(1);
                    }
                } else {
                    if (PDA_Local.category != 0 && PDA_Local.page >= 0) {
                        if (buttonType != "armor") {
                            PDA_SetPage(categoryPage);
                            PDA_Local.scrollingY = 20.0;
                        }
                    }
                }

                PDA_LocalMouse.state = cursor_default;
                PDA_LocalMouse.oldState = PDA_LocalMouse.state;
                break;
        }
    }

    // End
    PDA_LocalButton[id].oldState = PDA_LocalButton[id].state;

    TraceLog("PDA_ButtonLogic");
}

function void PDA_DrawButton (int id, str message, bool onlyVisual, bool clear) {
    #define buttonType PDA_LocalButton[id].type
    #define buttonOnHover PDA_LocalButton[id].state == button_hovered
    #define ifGraphicPTAB StrCmp(PDA_LocalButton[id].graphic, "PTAB") == 0

    fixed xlabeloff = (ifGraphicPTAB) ? 4.0 : 0.0;
    fixed ylabeloff = (ifGraphicPTAB) ? 3.0 : 0.0;

    int warningID = id - 50;
    int newColor = CR_UNTRANSLATED;

    if (warningID < 0) warningID = 0;
    if (warningID > 4) warningID = 4;

    switch (PDA_LocalButton[id].state) {
        case button_hovered:
            PDA_SetFullDirty();

            if (StrCmp(message, "") != 0) {
                SetFont(PDA_FONT[slim_font]);
                SetHudClipRect(
                    PDA_MENU_TOOLTIP_X,     PDA_MENU_TOOLTIP_Y,
                    PDA_MENU_TOOLTIP_WIDTH, PDA_MENU_TOOLTIP_HEIGHT,
                    PDA_MENU_TOOLTIP_WIDTH
                );
                PDA_TooltipDirty(HUDMSG_PLAIN, PDA_CAT_DESCRIPTION + id, CR_UNTRANSLATED, PDA_MENU_TOOLTIP_X + X_LEFT_EDGE, PDA_MENU_TOOLTIP_Y + Y_TOP_EDGE, INF_HOLDTIME, OPAQUE, s:message);

                PDA_SetupScreenBounds_Wipeless();
            }
            break;
    }

    if (PDA_LocalButton[id].oldState == button_hovered && PDA_LocalButton[id].state != button_hovered) {
        PDA_SetFullDirty();

        PDA_TooltipDirty(HUDMSG_PLAIN, PDA_CAT_DESCRIPTION + id, CR_UNTRANSLATED, PDA_MENU_TOOLTIP_X + X_LEFT_EDGE, PDA_MENU_TOOLTIP_Y + Y_TOP_EDGE, INF_HOLDTIME, OPAQUE, s:"");
    }

    // I hate this condition setup. Dargh.
    if (buttonType == "assembly") {
        if (PDA_LocalButton[id].tooltip != "???") {
            PDA_LocalButton[id].alpha = (buttonOnHover) ? pulser(2.0, DEFAULT_BUTTON_ALPHA + 0.2) : DEFAULT_BUTTON_ALPHA;
        } else {
            PDA_LocalButton[id].alpha = (buttonOnHover) ? 1.0 : DEFAULT_BUTTON_ALPHA;
        }
    } else {
        if (buttonType != "modpack" && buttonType != "tab" && buttonType != "armor") {
            PDA_LocalButton[id].alpha = (buttonOnHover) ? pulser(2.0, DEFAULT_BUTTON_ALPHA + 0.2) : DEFAULT_BUTTON_ALPHA;
        }
        if (buttonType == "armor") {
            PDA_LocalButton[id].alpha = buttonOnHover ? 1.0 : DEFAULT_BUTTON_ALPHA;
        }
    }

    if (!PDA_ParallaxNeedsDraw) {
        return;
    }

    // Button graphic
    PrintSpriteAlpha(PDA_LocalButton[id].graphic, PDA_LocalButton[id].graphicID, PDA_LocalButton[id].graphicX, PDA_LocalButton[id].graphicY, INF_HOLDTIME, PDA_LocalButton[id].alpha, false);

    if (buttonType == "beast") {
        newColor = PDA_LocalButton[id].textColor;

        if (PDA_Local.newEntry[warningID]) {
            newColor = CR_GOLD;

            if (PDA_Local.page == 1) {
                HudMessage(s:"New entry!\n";
                    HUDMSG_ALPHA, id + 5, CR_GREEN, thisButton.textX + thisButton.width - 10.0, thisButton.textY - 6.0, 0.0, pulser(2.0, DEFAULT_BUTTON_ALPHA + 0.2)
                );
            }
        }
    }

    // Button text
    SetFont(PDA_LocalButton[id].textFont);
    PDA_HudDirty(PDA_LocalButton[id].textFlags, PDA_LocalButton[id].textID, newColor, PDA_LocalButton[id].textX, PDA_LocalButton[id].textY, INF_HOLDTIME, PDA_LocalButton[id].alpha, s:PDA_LocalButton[id].label);

    if (clear) {
        PrintSpriteAlpha(PDA_LocalButton[id].graphic, PDA_LocalButton[id].graphicID, PDA_LocalButton[id].graphicX, PDA_LocalButton[id].graphicY, 0.0, 0.0, true);
        HudMessage(s:" "; PDA_LocalButton[id].textFlags, PDA_LocalButton[id].textID, newColor, PDA_LocalButton[id].textX, PDA_LocalButton[id].textY, 1.0, 0.0);
        HudMessage(s:" "; HUDMSG_ALPHA, id + 5, CR_GREEN, thisButton.textX + thisButton.width - 10.0, thisButton.textY - 6.0, 0.0, 0.0);
    }
    TraceLog("PDA_DrawButton");
}

function void PDA_ButtonHandler (int id, int inCategory, int categoryPage, str message, bool onlyVisual, bool clear) {
    PDA_ButtonLogic(id, inCategory, categoryPage, onlyVisual);

    PDA_DrawButton(id, message, onlyVisual, clear);
    TraceLog("PDA_ButtonHandler");
}

function void PDA_DrawHeaderText(str text, fixed x, fixed y) {
    PDA_SetupHeaderBounds();
    HEADER_BOUNDS()

    int _xTemp = (int)(x * NEW_RESOLUTION_X);
    int _yTemp = (int)(y * NEW_RESOLUTION_Y);
    fixed finalX = _xTemp + X_LEFT_EDGE;
    fixed finalY = _yTemp + Y_TOP_EDGE;
    log("headH[%d: > (%f:) < %d:] || headY[%d: > (%f:) < %d:]", headX, finalX, headX + headW, headY, finalY, headY + headH);
    if (finalX < headX || finalX > headX + headW) {
        log("Header text outside horizontal clipping bounds");
    }
    if (finalY < headY || finalY > headY + headH) {
        log("Header text outside vertical clipping bounds");
    }

    HudMessage(l:text; HUDMSG_ALPHA, PDA_INFOTOPID, CR_GREEN,
               finalX, finalY,
               INF_HOLDTIME, OPAQUE);
}


function void PDA_DrawBodyText_Set(int type, int id, int color, fixed x, fixed y, fixed hold, fixed alpha) {
    PDA_SetupScreenBounds();
    BODY_BOUNDS()

    fixed finalX = (int)(((PDA_BODY_X                       ) + x) * NEW_RESOLUTION_X) + X_LEFT_EDGE;
    fixed finalY = (int)(((PDA_BODY_Y + PDA_Local.scrollingY) + y) * NEW_RESOLUTION_Y) + Y_TOP_EDGE;

    log("body_y %d: scrolly %f: y %f: new_res_y %f:", PDA_BODY_X, PDA_Local.scrollingY, y, NEW_RESOLUTION_Y);

    log("bodyH[%d: > (%f:) < %d:] || bodyY[%d: > (%f:) < %d:]", bodyX, finalX, bodyX + bodyW, bodyY, finalY, bodyY + bodyH);
    if (finalX < bodyX || finalX > bodyX + bodyW) {
        log("Body text outside horizontal clipping bounds");
    }
    if (finalY < bodyY || finalY > bodyY + bodyH) {
        log("Body text outside vertical clipping bounds");
    }

    if (PDA_ParallaxNeedsDraw) {
        PDA_HudSet(type, id, color, finalX, finalY, hold, alpha);
    }
}

#define PDA_DrawBodyText(type, id, color, x, y, hold, alpha, ...) do { \
    PDA_DrawBodyText_Set(type, id, color, x, y, hold, alpha); \
    PDA_Hud(__VA_ARGS__); \
} while(0) \

function void PDA_HandleHeader(void) {
    if (PDA_CategoryChanged || PDA_PageChanged) {
        PDA_SetFullDirty();

        switch (PDA_Local.category) {
            case PDA_MENU:
                PDA_Local.pageMax = 1;

                PDA_HEADER_STR = "PDA_MENU_HEADER"; PDA_HEADER_X_OFFSET = 0;
                break;

            case PDA_CLASSES:
                PDA_Local.pageMax = 2;

                switch(PDA_Local.page) {
                    case CLASSES_PAGE_PERKS: PDA_HEADER_STR = "PDA_CLASS_HEADER1"; PDA_HEADER_X_OFFSET = 5; break;
                    case CLASSES_PAGE_STORY: PDA_HEADER_STR = "PDA_CLASS_HEADER2"; PDA_HEADER_X_OFFSET = 0; break;
                }
                break;

            case PDA_WEAPONS:
                PDA_Local.pageMax = 3;

                switch (PDA_Local.page) {
                    case WEAPON_PAGE_STORY:
                        PDA_HEADER_STR = "PDA_WEAPON_HEADER"; PDA_HEADER_X_OFFSET = 0;
                        break;
                    case WEAPON_PAGE_MODPACK_EFFECTS:
                        PDA_HEADER_STR = "PDA_MODPACK_HEADER"; PDA_HEADER_X_OFFSET = -10;
                        break;
                    case WEAPON_PAGE_ARTIFACT_EFFECTS:
                        PDA_HEADER_STR = "PDA_DEMONARTIFACT_HEADER"; PDA_HEADER_X_OFFSET = -20;
                        break;
                }
                break;

            case PDA_BESTIARY:
                PDA_Local.pageMax = 6;

                switch (PDA_Local.page) {
                    case 1: PDA_HEADER_STR = "PDA_BESTIARY_HEADER";    PDA_HEADER_X_OFFSET =   0;                               break;
                    case 2: PDA_HEADER_STR = "PDA_BESTIARY_HEADER_UV"; PDA_HEADER_X_OFFSET = -40; beast_info[2] = CR_WHITE;     break;
                    case 3: PDA_HEADER_STR = "PDA_BESTIARY_HEADER_NM"; PDA_HEADER_X_OFFSET = -30; beast_info[2] = CR_BRICK;     break;
                    case 4: PDA_HEADER_STR = "PDA_BESTIARY_HEADER_TP"; PDA_HEADER_X_OFFSET = -50; beast_info[2] = CR_LIGHTBLUE; break;
                    case 5: PDA_HEADER_STR = "PDA_BESTIARY_HEADER_AR"; PDA_HEADER_X_OFFSET = -40; beast_info[2] = CR_GOLD;      break;
                    case 6: PDA_HEADER_STR = "PDA_BESTIARY_HEADER_SP"; PDA_HEADER_X_OFFSET = -20; beast_info[2] = CR_PURPLE;    break;
                }
                break;
            case PDA_ARMORS:
                PDA_Local.pageMax = 2;

                switch (PDA_Local.page) {
                    case EQUIPMENT_PAGE_ONHAND:
                        PDA_HEADER_STR = "PDA_ARMOR_HEADER1"; PDA_HEADER_X_OFFSET = -20;
                        break;
                    case EQUIPMENT_PAGE_INFO:
                        PDA_HEADER_STR = "PDA_ARMOR_HEADER2"; PDA_HEADER_X_OFFSET = -15;
                        break;
                }
                break;

            case PDA_ASSEMBLIES:
                PDA_Local.pageMax = 3;
                switch (PDA_Local.page) {
                    case ASSEMBLY_PAGE_BASIC:
                        PDA_HEADER_STR = "PDA_ASSEMBLY_BASIC_NAME"; PDA_HEADER_X_OFFSET = -30;
                        break;
                    case ASSEMBLY_PAGE_ADVANCED:
                        PDA_HEADER_STR = "PDA_ASSEMBLY_ADVANCED_NAME"; PDA_HEADER_X_OFFSET = -30;
                        break;
                    case ASSEMBLY_PAGE_MASTER:
                        PDA_HEADER_STR = "PDA_ASSEMBLY_MASTER_NAME"; PDA_HEADER_X_OFFSET = -30;
                        break;
                }
                break;

            case PDA_HELP:
                PDA_Local.pageMax = 2;

                switch(PDA_Local.page) {
                    case 1: PDA_HEADER_STR = "PDA_PDAHELP_HEADER"; PDA_HEADER_X_OFFSET = -10; break;
                    case 2: PDA_HEADER_STR = "PDA_DRLAHELP_HEADER"; PDA_HEADER_X_OFFSET = -40; break;
                    case 3: PDA_HEADER_STR = "PDA_DMGHELP_HEADER"; PDA_HEADER_X_OFFSET = -40; break;
                }
                break;
            case PDA_MISC:
                PDA_Local.pageMax = 1;

                PDA_HEADER_STR = "PDA_MISC_HEADER"; PDA_HEADER_X_OFFSET = 10;
                break;

            case PDA_ITEMS:
                break;
            case PDA_ARMOR_DETAIL:
                PDA_Local.pageMax = 1;

                PDA_HEADER_STR = "PDA_DETAILEDARMOR_HEADER"; PDA_HEADER_X_OFFSET = -60;
                break;
            case PDA_ASSEMBLY_DETAIL:
                PDA_Local.pageMax = 1;

                PDA_HEADER_STR = "PDA_DETAILEDASSEMBLY_HEADER"; PDA_HEADER_X_OFFSET = -30;
                break;
            case PDA_BESTIARY_DETAIL:
                PDA_Local.pageMax = 1;

                PDA_HEADER_STR = "PDA_DETAILEDBEAST_HEADER"; PDA_HEADER_X_OFFSET = -30;
                break;
            case PDA_CREDITS:
                PDA_Local.pageMax = 1;

                PDA_HEADER_STR = "PDA_CREDITS_HEADER"; PDA_HEADER_X_OFFSET = 0;
                break;
        }
    }

    // Then print the header
    if (PDA_ParallaxNeedsDraw) {
        PDA_DefaultFont();
        PDA_DrawHeaderText(PDA_HEADER_STR, PDA_HEADER_X + PDA_HEADER_X_OFFSET, PDA_SCREEN_Y + 6.0);
    }
    PDA_SetupScreenBounds();
    TraceLog("PDA_HandleHeader");
}


function void PDA_TrackScrollArrows (void) {
    switch (PDA_Local.category) {
        case PDA_MENU:
            PDA_SetScrollArrows2(-30, PDA_SCREEN_WIDTH + 60.0, PDA_SCROLLABLE_HEIGHT + 90.0);
            break;

        case PDA_CLASSES:
            switch (PDA_Local.page) {
                case CLASSES_PAGE_PERKS:
                    break;
                case CLASSES_PAGE_STORY:
                    PDA_SetScrollArrows2(120, PDA_SCREEN_WIDTH + 60.0, PDA_SCROLLABLE_HEIGHT + 90.0);
                    break;
            }
            break;

        case PDA_WEAPONS:
            switch (PDA_Local.page) {
                case WEAPON_PAGE_STORY:
                    break;
                case WEAPON_PAGE_MODPACK_EFFECTS:
                    PDA_SetScrollArrows2(-60, PDA_SCREEN_WIDTH + 60.0, PDA_SCROLLABLE_HEIGHT + 90.0);
                    break;
                case WEAPON_PAGE_ARTIFACT_EFFECTS:
                    PDA_SetScrollArrows2(-80, PDA_SCREEN_WIDTH + 50.0, PDA_SCROLLABLE_HEIGHT + 90.0);
                    break;
            }
            break;

        case PDA_BESTIARY:
            PDA_SetScrollWindow(-240);

            switch (PDA_Local.page) {
                case BESTIARY_PAGE_DIFFICULTIES:
                    PDA_SetScrollArrows2(0, PDA_SCREEN_WIDTH + 60.0, PDA_SCROLLABLE_HEIGHT + 90.0);
                    break;
                default:
                    PDA_SetScrollArrows2(DRLA_MONSTER_PAGE_MAX * -10, PDA_SCREEN_WIDTH + 60.0, PDA_SCROLLABLE_HEIGHT + 90.0);
                    break;
            }
            break;
        case PDA_ARMORS:
            switch (PDA_Local.page) {
                case EQUIPMENT_PAGE_ONHAND:
                    if (localHasBackpack) {
                        PDA_SetScrollArrows2(-140, PDA_SCREEN_WIDTH + 60.0, PDA_SCROLLABLE_HEIGHT + 90.0);
                    } else {
                        PDA_SetScrollArrows2(-80 , PDA_SCREEN_WIDTH + 60.0, PDA_SCROLLABLE_HEIGHT + 90.0);
                    }
                    break;
                case EQUIPMENT_PAGE_INFO:
                    PDA_SetScrollArrows2(-160, PDA_SCREEN_WIDTH + 60.0, PDA_SCROLLABLE_HEIGHT + 90.0);
                    break;
            }
            break;

        case PDA_ASSEMBLIES:
            int scrollOffset = -8 * PDA_Local.maxAssembliesPer;
            PDA_SetScrollArrows2(scrollOffset, PDA_SCREEN_WIDTH + 60.0, PDA_SCROLLABLE_HEIGHT + 90.0);
            break;

        case PDA_HELP:
            break;
        case PDA_MISC:
            PDA_SetScrollArrows2(0, PDA_SCREEN_WIDTH + 50.0, PDA_SCROLLABLE_HEIGHT + 90.0);
            break;

        case PDA_ITEMS:
            PDA_SetScrollArrows2(-200, PDA_SCREEN_WIDTH + 50.0, PDA_SCROLLABLE_HEIGHT + 90.0);
            break;
        case PDA_ASSEMBLY_DETAIL:
            PDA_SetScrollArrows2(-100, PDA_SCREEN_WIDTH + 60.0, PDA_SCROLLABLE_HEIGHT + 90.0);
            break;
        case PDA_BESTIARY_DETAIL:
            if (stricmp(PDA_Local.detailFetch[0], "null") != 0) {
                PDA_SetScrollArrows2(-100, PDA_SCREEN_WIDTH + 60.0, PDA_SCROLLABLE_HEIGHT + 90.0);
            }
            break;
        case PDA_CREDITS:
            PDA_SetScrollWindow(0);
            break;
    }
    TraceLog("PDA_TrackScrollArrows");
}

// EOF
