function void PDA_ClearHeader (void) {
    HudMessage(s:""; HUDMSG_PLAIN, PDA_INFOTOPID, CR_GREEN, 0.0, 0.0, 0.0);
    TraceLog("PDA_ClearHeader");
}


// Text drawing functions w/ built in bounds checking
// I should have done this many years ago.. x.x
// ========================================================
function void PDA_DrawHeaderText (str text, fixed x, fixed y) {
    PDA_SetupHeaderBounds();
    HEADER_BOUNDS()

    // Keep text-draw modifiers since we don't use PDA_HudSet yet
    fixed finalX = (int)(x * NEW_RESOLUTION_X);
    fixed finalY = (int)(y * NEW_RESOLUTION_Y);

    if (debug) {
        log("headH[%d: > (%f:) < %d:] || headY[%d: > (%f:) < %d:]", head[0], finalX, head[0] + head[2], head[1], finalY, head[1] + head[3]);
    }

    checkTextBounds(head, "Head")

    // TODO: Should we use our specialized hud printer here?
    if (PDA_NeedsDraw) {
        HudMessage(l:text; HUDMSG_ALPHA, PDA_INFOTOPID, CR_GREEN,
            finalX + X_CENTER_TEXT_CENTER, finalY + Y_TOP_EDGE,
            INF_HOLDTIME, OPAQUE);
    }
}

function void PDA_DrawBodyText_Set (int type, int id, int color, fixed x, fixed y, fixed hold, fixed alpha, bool scrollable, fixed xAlignment, fixed yAlignment) {
    PDA_SetupScreenBounds();
    BODY_BOUNDS()

    // x_left_edge and y_top_edge are already handled by pda_hudset
    fixed finalX = (int)((PDA_BODY_X + x                                                             ) * NEW_RESOLUTION_X);
    fixed finalY = (int)((PDA_BODY_Y + y + (scrollable ? (PDA_Local.scrollingY - PDA_SCROLL_TOP) : 0)) * NEW_RESOLUTION_Y);

    if (debug) {
        log("bodyW[%d: > (%f:) < %d:] || bodyH[%d: > (%f:) < %d:]", body[0], finalX, body[0] + body[2], body[1], finalY, body[1] + body[3]);
    }

    checkTextBounds(body, "Body")

    if (!xAlignment) xAlignment = DEFAULT_ALIGN;
    if (!yAlignment) yAlignment = DEFAULT_ALIGN;

    PDA_HudSet(type, id, color, finalX, finalY, hold, alpha, xAlignment, yAlignment);
}

function void PDA_DrawTooltipText_Set (int type, int id, int color, fixed x, fixed y, fixed hold, fixed alpha, fixed xAlignment, fixed yAlignment) {
    PDA_SetupTooltipBounds();
    TOOLTIP_BOUNDS()

    // LEFT_EDGE already set by PDA_HudSet
    // This should not scroll
    fixed finalX = (int)((PDA_MENU_TOOLTIP_X - PDA_SCREEN_X + x) * NEW_RESOLUTION_X);
    fixed finalY = (int)((PDA_MENU_TOOLTIP_Y                + y) * NEW_RESOLUTION_Y);

    if (debug && PDA_ScrollableNeedsDraw) {
        log("tipW[%d: > (%f:) < %d:] || tipH[%d: > (%f:) < %d:]", tip[0], finalX, tip[0] + tip[2], tip[1], finalY, tip[1] + tip[3]);
    }

    checkTextBounds(tip, "Tip")

    if (!xAlignment) xAlignment = DEFAULT_ALIGN;
    if (!yAlignment) yAlignment = DEFAULT_ALIGN;

    if (PDA_NeedsDraw) {
        SetFont(PDA_FONT[slim_font]);
        PDA_HudSet(type, id, color, finalX, finalY, hold, alpha, xAlignment, yAlignment);
    }
}
