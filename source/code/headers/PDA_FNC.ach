function void PDA_ClearHeader (void) {
    HudMessage(s:""; HUDMSG_PLAIN, PDA_INFOTOPID, CR_GREEN, PDA_SCREEN_X + 100.0 + PDA_HEADING_X_OFFSET + X_LEFT_EDGE, PDA_SCREEN_Y + 2.0 + Y_TOP_EDGE, 0.0);
    TraceLog("PDA_ClearHeader");
}

function void PDA_UnsetScrollWindow (void) {
    PDA_SetupScreenBounds();
    TraceLog("PDA_UnsetScrollWindow");
}

// Text drawing functions w/ built in bounds checking
// I should have done this many years ago.. x.x
// ========================================================
function void PDA_DrawHeaderText (str text, fixed x, fixed y) {
    PDA_SetupHeaderBounds();
    HEADER_BOUNDS()

    fixed finalX = (int)(x * NEW_RESOLUTION_X) + X_CENTER_TEXT_CENTER;
    fixed finalY = (int)(y * NEW_RESOLUTION_Y) + Y_TOP_EDGE;

    if (debug) {
        log("headH[%d: > (%f:) < %d:] || headY[%d: > (%f:) < %d:]", head[0], finalX, head[0] + head[2], head[1], finalY, head[1] + head[3]);
    }
    if (finalX < head[0] || finalX > head[0] + head[2]) {
        log("Header text outside horizontal clipping bounds");
    }
    if (finalY < head[1] || finalY > head[1] + head[3]) {
        log("Header text outside vertical clipping bounds");
    }

    // TODO: Should we use our specialized hud printer here?
    if (PDA_NeedsDraw) {
        HudMessage(l:text; HUDMSG_ALPHA, PDA_INFOTOPID, CR_GREEN, finalX, finalY, INF_HOLDTIME, OPAQUE);
    }
}

function void PDA_DrawBodyText_Set (int type, int id, int color, fixed x, fixed y, fixed hold, fixed alpha, bool parallax) {
    PDA_SetupScreenBounds();
    BODY_BOUNDS()

    // x_left_edge and y_top_edge are already handled by pda_hudset
    // along with scrollingY
    fixed finalX = (int)((PDA_BODY_X + x) * NEW_RESOLUTION_X);
    fixed finalY = (int)((PDA_BODY_Y + y) * NEW_RESOLUTION_Y);

    log("final[%f:, %f:]", finalX, finalY);

    if (debug) {
        log("bodyW[%d: > (%f:) < %d:] || bodyH[%d: > (%f:) < %d:]", body[0], finalX, body[0] + body[2], body[1], finalY, body[1] + body[3]);
    }

    if (finalX < body[0] || finalX > body[0] + body[2]) {
        log("Body text outside horizontal clipping bounds");
    }
    if (finalY < body[1] || finalY > body[1] + body[3]) {
        log("Body text outside vertical clipping bounds");
    }

    if (parallax) {
        PDA_HudSetP(type, id, color, finalX, finalY, hold, alpha);
    } else {
        PDA_HudSet(type, id, color, finalX, finalY, hold, alpha);
    }
}

function void PDA_DrawTooltipText_Set (int type, int id, int color, fixed x, fixed y, fixed hold, fixed alpha) {
    PDA_SetupTooltipBounds();
    TOOLTIP_BOUNDS()

    fixed finalX = (int)(PDA_MENU_TOOLTIP_X + 5.0                  + x) + X_LEFT_EDGE;
    fixed finalY = (int)(PDA_MENU_TOOLTIP_Y + PDA_Local.scrollingY + y) + Y_TOP_EDGE;

    if (debug) {
        log("tipW[%d: > (%f:) < %d:] || tipH[%d: > (%f:) < %d:]", tip[0], finalX, tip[0] + tip[2], tip[1], finalY, tip[1] + tip[3]);
    }

    if (finalX < tip[0] || finalX > tip[0] + tip[2]) {
        log("Tooltip text outside horizontal clipping bounds");
    }
    if (finalY < tip[1] || finalY > tip[1] + tip[3]) {
        log("Tooltip text outside vertical clipping bounds");
    }

    if (PDA_NeedsDraw) {
        SetFont(PDA_FONT[slim_font]);
        PDA_HudSet(type, id, color, finalX, finalY, hold, alpha);
    }
}
