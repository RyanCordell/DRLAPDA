function PDAButton PDA_CreateModPackDisplay (int id, str graphic, fixed x, fixed y, int width, int height, fixed alpha) {
    #define thisButton PDA_LocalButton[id]
    assignButtonParams(thisButton, StrParam("%l:", stringArray[MODS_DIM][id]))

    thisButton.graphic      = graphic;
    thisButton.graphicFlags = HUDMSG_ALPHA;
    thisButton.graphicID    = PDA_ASSEMBLY_ID_END + PDA_MODMAX + thisButton.id;
    thisButton.graphicX     = (int)(thisButton.x * NEW_RESOLUTION_X + 15.0) + X_LEFT_EDGE;
    thisButton.graphicY     = (int)(thisButton.y * NEW_RESOLUTION_Y) + Y_TOP_EDGE;
    thisButton.type         = "modpack";

    thisButton.textFlags = HUDMSG_ALPHA;
    thisButton.textFont  = PDA_FONT[mono_font];
    thisButton.textID    = PDA_ASSEMBLY_ID_END + thisButton.id;
    thisButton.textX     = (int)(thisButton.graphicX) + 5.0 + X_LEFT_EDGE;
    thisButton.textY     = (int)(thisButton.graphicY) + 2.0 + Y_TOP_EDGE;

    thisButton.alpha = alpha;

    // SetFont(thisButton.textFont);
    // HudMessage("%l:", stringArray[id]; thisButton.textFlags, PDA_ASSEMBLY_ID_END + id, CR_UNTRANSLATED,
    //     thisButton.textX, thisButton.textY,
    //     0.INF_HOLDTIME, OPAQUE);

    TraceLog("PDA_CreateModPackDisplay");
    return thisButton;
}

function void PDA_ButtonLogic (int id, int inCategory, int categoryPage, bool onlyVisual) {
    #define buttonType PDA_LocalButton[id].type

    if (buttonType == "tab") {
        PDA_SetupHeaderBounds();

        if (inCategory > 0 && PDA_Local.page == categoryPage) {
            // I wonder why I did this..
            PDA_LocalButton[id].state = button_hovered;
            PDA_LocalButton[id].alpha = 1;
        }
    }

    if (!onlyVisual) {
        buttonBoundsDefault(PDA_LocalButton[id]);

        if (PDA_LocalButton[id].state != PDA_LocalButton[id].oldState) {
            PDA_SetFullDirty();
        }

        switch (PDA_LocalButton[id].state) {
            case button_clicked:
                if (!inCategory) {
                    if (buttonType != "armor") PDA_SetCategory(categoryPage);

                    if (PDA_Local.category != PDA_ASSEMBLY_DETAIL) {
                        if (buttonType != "armor") PDA_SetPage(1);
                    }
                } else {
                    if (PDA_Local.category != 0 && PDA_Local.page >= 0) {
                        if (buttonType != "armor") {
                            PDA_SetPage(categoryPage);
                            PDA_Local.scrollingY = 20.0;
                        }
                    }
                }

                PDA_LocalMouse.state = cursor_default;
                PDA_LocalMouse.oldState = PDA_LocalMouse.state;
                break;
        }
    }

    // End
    PDA_LocalButton[id].oldState = PDA_LocalButton[id].state;

    TraceLog("PDA_ButtonLogic");
}

function void PDA_DrawButton (int id, str message, bool onlyVisual, bool clear) {
    #define thisButton PDA_LocalButton[id]
    #define buttonType PDA_LocalButton[id].type
    #define buttonOnHover PDA_LocalButton[id].state == button_hovered
    #define ifGraphicPTAB StrCmp(PDA_LocalButton[id].graphic, "PTAB") == 0

    fixed xlabeloff = (ifGraphicPTAB) ? 4.0 : 0.0;
    fixed ylabeloff = (ifGraphicPTAB) ? 3.0 : 0.0;

    int warningID = id - 50;
    int newColor = CR_UNTRANSLATED;

    if (warningID < 0) warningID = 0;
    if (warningID > 4) warningID = 4;

    switch (thisButton.state) {
        case button_hovered:
            PDA_SetFullDirty();

            if (StrCmp(message, "") != 0) {
                PDA_DrawTooltipText(HUDMSG_PLAIN, PDA_CAT_DESCRIPTION, CR_UNTRANSLATED,
                                    0.0, 0.0,
                                    INF_HOLDTIME, OPAQUE, s:message);
            }
            break;
    }

    if (thisButton.oldState == button_hovered && thisButton.state != button_hovered) {
        PDA_SetFullDirty();

        PDA_DrawTooltipText(HUDMSG_PLAIN, PDA_CAT_DESCRIPTION, CR_UNTRANSLATED,
                            0.0, 0.0,
                            INF_HOLDTIME, 0.0, s:"");
    }

    // I hate this condition setup. Dargh.
    if (buttonType == "assembly") {
        if (thisButton.tooltip != "???") {
            thisButton.alpha = (buttonOnHover) ? pulser(2.0, DEFAULT_BUTTON_ALPHA + 0.2) : DEFAULT_BUTTON_ALPHA;
        } else {
            thisButton.alpha = (buttonOnHover) ? 1.0 : DEFAULT_BUTTON_ALPHA;
        }
    } else {
        if (buttonType != "modpack" && buttonType != "tab" && buttonType != "armor") {
            thisButton.alpha = (buttonOnHover) ? pulser(2.0, DEFAULT_BUTTON_ALPHA + 0.2) : DEFAULT_BUTTON_ALPHA;
        }
        if (buttonType == "armor") {
            thisButton.alpha = buttonOnHover ? 1.0 : DEFAULT_BUTTON_ALPHA;
        }
    }

    if (PDA_ScrollMoved && buttonType != "tab") {
        thisButton.y        = (int)(PDA_Local.scrollingY + thisButton.rawY);
        thisButton.graphicY = (int)(thisButton.y * NEW_RESOLUTION_Y) + 10.0;
        thisButton.textY    = (int)(thisButton.y * NEW_RESOLUTION_Y) + (int)(ylabeloff * NEW_RESOLUTION_Y);
        PDA_SetFullDirty();
    }

    if (!PDA_ParallaxNeedsDraw) {
        return;
    }

    // Button graphic
    PrintSpriteAlpha(thisButton.graphic, thisButton.graphicID, thisButton.graphicX, thisButton.graphicY, INF_HOLDTIME, thisButton.alpha, false);

    if (buttonType == "beast") {
        newColor = thisButton.textColor;

        if (PDA_Local.newEntry[warningID]) {
            newColor = CR_GOLD;

            if (PDA_Local.page == 1) {
                HudMessage(s:"New entry!\n";
                    HUDMSG_ALPHA, id + 5, CR_GREEN, thisButton.textX + thisButton.width - 10.0, thisButton.textY - 6.0, 0.0, pulser(2.0, DEFAULT_BUTTON_ALPHA + 0.2)
                );
            }
        }
    }

    // Button text
    SetFont(thisButton.textFont);
    PDA_HudDirty(thisButton.textFlags, thisButton.textID, newColor, thisButton.textX, thisButton.textY, INF_HOLDTIME, thisButton.alpha, s:thisButton.label);

    if (clear) {
        // Button graphic
        PrintSpriteAlpha(thisButton.graphic, thisButton.graphicID, thisButton.graphicX, thisButton.graphicY, INF_HOLDTIME, 0.0, B_CLEAR);

        // Button text
        PDA_HudDirty(thisButton.textFlags, thisButton.textID, newColor, thisButton.textX, thisButton.textY, INF_HOLDTIME, 0.0, s:"");

        PDA_TooltipDirty(HUDMSG_PLAIN, PDA_CAT_DESCRIPTION, CR_UNTRANSLATED, PDA_MENU_TOOLTIP_X + X_LEFT_EDGE, PDA_MENU_TOOLTIP_Y + Y_TOP_EDGE, INF_HOLDTIME, 0.0, s:"");

        // HudMessage(s:" "; thisButton.textFlags, thisButton.textID, newColor, thisButton.textX, thisButton.textY, 1.0, 0.0);
        //
        // HudMessage(s:" "; HUDMSG_ALPHA, id + 5, CR_GREEN, thisButton.textX + thisButton.width - 10.0, thisButton.textY - 6.0, 0.0, 0.0);
    }
    TraceLog("PDA_DrawButton");
}

function void PDA_ButtonHandler (int id, int inCategory, int categoryPage, str message, bool onlyVisual, bool clear) {
    PDA_ButtonLogic(id, inCategory, categoryPage, onlyVisual);

    PDA_DrawButton(id, message, onlyVisual, clear);
    TraceLog("PDA_ButtonHandler");
}

function void PDA_HandleHeader(void) {
    str PDA_HEADER_STR = "PDA_MENU_HEADER";
    if (PDA_CategoryChanged || PDA_PageChanged) {
        PDA_SetFullDirty();

        switch (PDA_Local.category) {
            case PDA_MENU:
                PDA_Local.pageMax = 1;

                PDA_HEADER_STR = "PDA_MENU_HEADER"; PDA_HEADING_X_OFFSET = 0;
                break;

            case PDA_CLASSES:
                PDA_Local.pageMax = 2;

                switch(PDA_Local.page) {
                    case CLASSES_PAGE_PERKS: PDA_HEADER_STR = "PDA_CLASS_HEADER1"; PDA_HEADING_X_OFFSET = 5; break;
                    case CLASSES_PAGE_STORY: PDA_HEADER_STR = "PDA_CLASS_HEADER2"; PDA_HEADING_X_OFFSET = 0; break;
                }
                break;

            case PDA_WEAPONS:
                PDA_Local.pageMax = 3;

                switch (PDA_Local.page) {
                    case WEAPON_PAGE_STORY:
                        PDA_HEADER_STR = "PDA_WEAPON_HEADER"; PDA_HEADING_X_OFFSET = 0;
                        break;
                    case WEAPON_PAGE_MODPACK_EFFECTS:
                        PDA_HEADER_STR = "PDA_MODPACK_HEADER"; PDA_HEADING_X_OFFSET = -10;
                        break;
                    case WEAPON_PAGE_ARTIFACT_EFFECTS:
                        PDA_HEADER_STR = "PDA_DEMONARTIFACT_HEADER"; PDA_HEADING_X_OFFSET = -20;
                        break;
                }
                break;

            case PDA_BESTIARY:
                PDA_Local.pageMax = 6;

                switch (PDA_Local.page) {
                    case 1: PDA_HEADER_STR = "PDA_BESTIARY_HEADER";    PDA_HEADING_X_OFFSET =   0;                               break;
                    case 2: PDA_HEADER_STR = "PDA_BESTIARY_HEADER_UV"; PDA_HEADING_X_OFFSET = -40; beast_info[BEAST__LV_COLOR] = CR_WHITE;     break;
                    case 3: PDA_HEADER_STR = "PDA_BESTIARY_HEADER_NM"; PDA_HEADING_X_OFFSET = -30; beast_info[BEAST__LV_COLOR] = CR_BRICK;     break;
                    case 4: PDA_HEADER_STR = "PDA_BESTIARY_HEADER_TP"; PDA_HEADING_X_OFFSET = -50; beast_info[BEAST__LV_COLOR] = CR_LIGHTBLUE; break;
                    case 5: PDA_HEADER_STR = "PDA_BESTIARY_HEADER_AR"; PDA_HEADING_X_OFFSET = -40; beast_info[BEAST__LV_COLOR] = CR_GOLD;      break;
                    case 6: PDA_HEADER_STR = "PDA_BESTIARY_HEADER_SP"; PDA_HEADING_X_OFFSET = -20; beast_info[BEAST__LV_COLOR] = CR_PURPLE;    break;
                }
                break;
            case PDA_ARMORS:
                PDA_Local.pageMax = 2;

                switch (PDA_Local.page) {
                    case EQUIPMENT_PAGE_ONHAND:
                        PDA_HEADER_STR = "PDA_ARMOR_HEADER1"; PDA_HEADING_X_OFFSET = -20;
                        break;
                    case EQUIPMENT_PAGE_INFO:
                        PDA_HEADER_STR = "PDA_ARMOR_HEADER2"; PDA_HEADING_X_OFFSET = -15;
                        break;
                }
                break;

            case PDA_ASSEMBLIES:
                PDA_Local.pageMax = 3;
                switch (PDA_Local.page) {
                    case ASSEMBLY_PAGE_BASIC:
                        PDA_HEADER_STR = "PDA_ASSEMBLY_BASIC_NAME"; PDA_HEADING_X_OFFSET = -30;
                        break;
                    case ASSEMBLY_PAGE_ADVANCED:
                        PDA_HEADER_STR = "PDA_ASSEMBLY_ADVANCED_NAME"; PDA_HEADING_X_OFFSET = -30;
                        break;
                    case ASSEMBLY_PAGE_MASTER:
                        PDA_HEADER_STR = "PDA_ASSEMBLY_MASTER_NAME"; PDA_HEADING_X_OFFSET = -30;
                        break;
                }
                break;

            case PDA_HELP:
                PDA_Local.pageMax = 2;

                switch(PDA_Local.page) {
                    case 1: PDA_HEADER_STR = "PDA_PDAHELP_HEADER"; PDA_HEADING_X_OFFSET = -10; break;
                    case 2: PDA_HEADER_STR = "PDA_DRLAHELP_HEADER"; PDA_HEADING_X_OFFSET = -40; break;
                    case 3: PDA_HEADER_STR = "PDA_DMGHELP_HEADER"; PDA_HEADING_X_OFFSET = -40; break;
                }
                break;
            case PDA_MISC:
                PDA_Local.pageMax = 1;

                PDA_HEADER_STR = "PDA_MISC_HEADER"; PDA_HEADING_X_OFFSET = 10;
                break;

            case PDA_ITEMS:
                break;
            case PDA_ARMOR_DETAIL:
                PDA_Local.pageMax = 1;

                PDA_HEADER_STR = "PDA_DETAILEDARMOR_HEADER"; PDA_HEADING_X_OFFSET = -60;
                break;
            case PDA_ASSEMBLY_DETAIL:
                PDA_Local.pageMax = 1;

                PDA_HEADER_STR = "PDA_DETAILEDASSEMBLY_HEADER"; PDA_HEADING_X_OFFSET = -30;
                break;
            case PDA_BESTIARY_DETAIL:
                PDA_Local.pageMax = 1;

                PDA_HEADER_STR = "PDA_DETAILEDBEAST_HEADER"; PDA_HEADING_X_OFFSET = -30;
                break;
            case PDA_CREDITS:
                PDA_Local.pageMax = 1;

                PDA_HEADER_STR = "PDA_CREDITS_HEADER"; PDA_HEADING_X_OFFSET = 0;
                break;
        }
    }

    // Then print the header
    if (PDA_ParallaxNeedsDraw) {
        PDA_DefaultFont();
        PDA_DrawHeaderText(PDA_HEADER_STR, PDA_HEADING_X, PDA_SCREEN_Y + 6.0);
    }
    PDA_SetupScreenBounds();
    TraceLog("PDA_HandleHeader");
}


