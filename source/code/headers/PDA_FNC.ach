#define _hm_type 0
#define _hm_id 1
#define _hm_color 2
int   _pda_hm_i[3];  // [0]=type  [1]=id     [2]=color

#define _hm_x 0
#define _hm_y 1
#define _hm_hold 2
#define _hm_alpha 3
fixed _pda_hm_f[4];  // [0]=x     [1]=y      [2]=hold   [3]=alpha

#define PDA_NeedsDraw (PDA_Local.dirty)
#define PDA_ParallaxNeedsDraw (PDA_Local.dirty || PDA_Local.scrollDirty)

#define TraceLog(message) do { \
    if (TraceDebug) log(s:(message)); \
} while(0) \

#define PDA_HudSet(type, id, color, x, y, hold, alpha) \
    _pda_hm_i[0] = (type);  \
    _pda_hm_i[1] = (id);    \
    _pda_hm_i[2] = (color); \
    _pda_hm_f[0] = (x);     \
    _pda_hm_f[1] = (y);     \
    _pda_hm_f[2] = (hold);  \
    _pda_hm_f[3] = (alpha); \

#define PDA_HudSetP(type, id, color, x, y, hold, alpha) \
    PDA_HudSet(type, id, color, \
        (x) + X_LEFT_EDGE, \
        (y) + Y_TOP_EDGE + PDA_Local.scrollingY, \
        hold, alpha) \

function void PDA_HudEnd(void) {
    MoreHudMessage();
    OptHudMessage(
        _pda_hm_i[_hm_type],_pda_hm_i[_hm_id],_pda_hm_i[_hm_color],
        _pda_hm_f[_hm_x],_pda_hm_f[_hm_y],_pda_hm_f[_hm_hold]
    );
    EndHudMessageX(_pda_hm_f[_hm_alpha]);
}

print PDA_Hud(
    (begin): BeginHudMessage,
    (end):   PDA_HudEnd,
    ACS_PrintPropertyBase()
);

#define PDA_TooltipDirty(...) PDA_HudDirty(__VA_ARGS__)

// do {} while(0) to help prevent dangling-else and similar stealth problems

#define PDA_HudDirty(type, id, color, x, y, hold, alpha, ...) do { \
    if (PDA_NeedsDraw) { \
        PDA_HudSetP(type, id, color, x, y - PDA_Local.scrollingY, hold, alpha); \
        PDA_Hud(__VA_ARGS__); \
    } \
} while(0) \

#define PDA_HudDirtyP(type, id, color, x, y, hold, alpha, ...) do { \
    if (PDA_ParallaxNeedsDraw) { \
        PDA_HudSetP(type, id, color, x, y, hold, alpha); \
        PDA_Hud(__VA_ARGS__); \
    } \
} while(0) \

#define PDA_HudDirtyV(type, id, color, x, y, hold, alpha, ...) do { \
    int _xTemp = (PDA_SCREEN_X + x) * NEW_RESOLUTION_X; \
    int _yTemp = (PDA_Local.scrollingY * NEW_RESOLUTION_Y) + y; \
    fixed _x = _xTemp + X_LEFT_EDGE; \
    fixed _y = _yTemp + Y_TOP_EDGE; \
    if (PDA_ParallaxNeedsDraw) { \
        PDA_HudSetP(type, id, color, _x, _y, hold, alpha); \
        PDA_Hud(__VA_ARGS__); \
    } \
} while(0) \

function int str_find(str haystack, str needle, int index) {
    int i           = index;
    int haystackLen = StrLen(haystack);
    int needleLen   = StrLen(needle);
    int matching    = 0;

    while (i < haystackLen) {
        if (GetChar(haystack, i) == GetChar(needle, 0)) {
            int remaining = needleLen - 1;
            int passed    = 1;

            while (remaining > 0) {
                if (GetChar(haystack, i + passed) == GetChar(needle, passed)) {
                    passed++;
                    remaining--;
                } else {
                    break;
                }
            }
            return (!remaining) ? i : -1;
        }
        i++;
    }

    return -1;
}

#define clearStringArray(dim) \
    for (int i = 0; i < STRING_ARRAY_MAX; i++) stringArray[dim][i] = ""; \

// Thanks to DavidPH!
function int str_split (str separator, str input, int dim) {
    int inputLen     = StrLen(input);
    int separatorLen = StrLen(separator);
    int n      = 0;
    int pos    = 0,
        oldPos = 0;

    clearStringArray(dim);

    while ((pos = str_find(input, separator, oldPos)) != -1) {
        stringArray[dim][n++] = StrMid(input, oldPos, pos - oldPos);
        oldPos = pos + separatorLen;
    }

    stringArray[dim][n++] = StrRight(input, inputLen - oldPos);

    return n+1;
}

function int batoi (str stri)  {
    int res = 0;

    for (int i = 0; stri[i] != '\0'; ++i) {
        res = res*10 + stri[i] - '0';
    }

    return res;
}

// kd: An "odd sensitivity cvar" is a mouse sensitivity cvar that became unavailable starting gzd
// 4.5.0 when mouse sensitivity stuff got overhauled. One example is mouse_sensitivity being removed
// and m_sensitivity_x and m_sensitivity_y being added instead.
function fixed GetOddSensitivityCVarFixed (str cvar_name, fixed default_value) {
    fixed cvar_value = GetCVarFixed(cvar_name);

    if (cvar_value == 0) {
        return default_value;
    }

    return cvar_value;
}

function fixed max (fixed x, fixed y) {
    return (x < y) ? y : x;
}



function void isDirtyBoy (str location) {
    log("simple dirty? %b: | parallax dirty? %b: | in %s: ", PDA_Local.dirty, PDA_Local.scrollDirty, location);
}


// Debugging functions for SetHudClipRect
function void PrintSprite (str Sprite, int ID, fixed X, fixed Y, fixed HoldTime, bool blank) {
    SetFont(Sprite);
    HudMessage(s:blank ? "" : "A\n"; HUDMSG_PLAIN, ID, CR_UNTRANSLATED, X, Y, HoldTime);
    TraceLog("PrintSprite");
}

function void PrintSpriteAlpha (str Sprite, int ID, fixed X, fixed Y, fixed HoldTime, fixed Alpha, bool blank) {
    SetFont(Sprite);
    HudMessage(s:blank ? "" : "A\n"; HUDMSG_ALPHA, ID, CR_UNTRANSLATED, X, Y, HoldTime, Alpha);
    TraceLog("PrintSpriteAlpha");
}

function void DrawBorder (int X, int Y, int Width, int Height) {
    SetHudClipRect(X, Y, Width, Height);
    PrintSpriteAlpha("BarHorz", 0, X,             Y,              0.05, 0.3, false);
    PrintSpriteAlpha("BarVert", 0, X,             Y,              0.05, 0.3, false);
    PrintSpriteAlpha("BarVert", 0, X + Width - 1, Y,              0.05, 0.3, false);
    PrintSpriteAlpha("BarHorz", 0, X,             Y + Height - 1, 0.05, 0.3, false);
    SetFont("");
    TraceLog("PDA_DrawBorder");
}

function void PDA_Wipe (str caller) {
    // Avoid wiping the header
    for (int wipeIndex = 0; wipeIndex <= PDA_INFOTOPID - 1; wipeIndex++) {
        HudMessage(s:"\n"; HUDMSG_PLAIN, wipeIndex, CR_UNTRANSLATED, 0, 0, 0.0, 0.0);
        HudMessage(s:"\n"; HUDMSG_ALPHA, wipeIndex, CR_UNTRANSLATED, 0, 0, 0.0, 0.0);
    }
    TraceLog("PDA_Wipe");
}

function void PDA_SuperWipe (str caller) {
    for (int wipeIndex = 0; wipeIndex <= PDA_REALLYLASTID; wipeIndex++) {
        HudMessage(s:"\n"; HUDMSG_PLAIN, wipeIndex, CR_UNTRANSLATED, 0, 0, 0.0, 0.0);
        HudMessage(s:"\n"; HUDMSG_ALPHA, wipeIndex, CR_UNTRANSLATED, 0, 0, 0.0, 0.0);
    }
    TraceLog("PDA_SuperWipe");
}

function void PDA_UnsetScrollWindow (void) {
    SetHudClipRect(PDA_SCREEN_X, PDA_SCREEN_Y, PDA_SCREEN_WIDTH, PDA_SCREEN_HEIGHT, PDA_SCREEN_WIDTH);
    TraceLog("PDA_UnsetScrollWindow");
}

#define afterPageDefaults(a) \
    PDA_Wipe((a)); \
    PDA_DefaultFont(); \
    PDA_UnsetScrollWindow(); \
    TraceLog("afterPageDefaults"); \


#define HEADER_BOUNDS() \
    int headX  = PDA_SCREEN_X + 4; \
    int headY  = PDA_SCREEN_Y + 8; \
    int headW  = PDA_SCREEN_WIDTH * NEW_RESOLUTION_X; \
    int headH  = headY - 8; \
    int headWW = (PDA_SCREEN_WIDTH * NEW_RESOLUTION_X) - PDA_SCREEN_X; \


#define BODY_BOUNDS() \
    int bodyX  = PDA_SCREEN_X + 4; \
    int bodyY  = PDA_SCROLLABLE_Y; \
    int bodyW  = PDA_SCREEN_WIDTH * NEW_RESOLUTION_X; \
    int bodyH  = PDA_SCROLLABLE_HEIGHT; \
    int bodyWW = (PDA_SCREEN_WIDTH * NEW_RESOLUTION_X) - (PDA_SCREEN_X * 3); \


function void PDA_SetupHeaderBounds (void) {
    SetHudSize(NEW_RESOLUTION_WIDTH, NEW_RESOLUTION_HEIGHT);

    HEADER_BOUNDS()

    SetHudClipRect(headX, headY, headW, headH, headWW);

    if (debug) {
        SetFont("HDR_BG");
        HudMessage(s:"A\n"; HUDMSG_ALPHA, PDA_DEBUG_HEADER, CR_UNTRANSLATED, 0.1, 0.1, INF_HOLDTIME, 0.24);
        PDA_DefaultFont();
    }
    TraceLog("PDA_SetupHeaderBounds");
}

function void PDA_SetupScreenBounds (void) {
    // SetHudClipRect(0,0,0,0,0);
    // PDA_Wipe("PDA_SetupScreenBounds"); // at least this finally seemed to help out w/ retention bugs
    SetHudSize(NEW_RESOLUTION_WIDTH, NEW_RESOLUTION_HEIGHT);

    BODY_BOUNDS()

    SetHudClipRect(bodyX, bodyY, bodyW, bodyH, bodyWW);

    if (debug) {
        SetFont("DBG_BG");
        HudMessage(s:"A\n"; HUDMSG_ALPHA, PDA_DEBUG_BODY, CR_UNTRANSLATED, 0.1, 0.1, INF_HOLDTIME, 0.24);
        PDA_DefaultFont();
    }
    TraceLog("PDA_SetupScreenBounds");
}
function void PDA_SetupScreenBounds_Wipeless (void) {
    SetHudSize(NEW_RESOLUTION_WIDTH, NEW_RESOLUTION_HEIGHT);

    int x = PDA_SCREEN_X + 4;
    int y = PDA_SCROLLABLE_Y;
    int w = PDA_SCREEN_WIDTH * NEW_RESOLUTION_X;
    int h = PDA_SCROLLABLE_HEIGHT;
    int ww = (PDA_SCREEN_WIDTH * NEW_RESOLUTION_X) - (PDA_SCREEN_X * 3);

    SetHudClipRect(x, y, w, h, ww);

    if (debug) {
        SetFont("DBG_BG");
        HudMessage(s:"A\n"; HUDMSG_ALPHA, PDA_DEBUG_BODY, CR_UNTRANSLATED, 0.1, 0.1, INF_HOLDTIME, 0.24);
        PDA_DefaultFont();
        // SetHudClipRect(x, y, w, h, ww);
    }
    TraceLog("PDA_SetupScreenBounds_Wipeless");
}

function void PDA_ClearHeader (void) {
    HudMessage(s:""; HUDMSG_PLAIN, PDA_INFOTOPID, CR_GREEN, PDA_SCREEN_X + 100.0 + PDA_HEADER_X_OFFSET + X_LEFT_EDGE, PDA_SCREEN_Y + 2.0 + Y_TOP_EDGE, 0.0);
    TraceLog("PDA_ClearHeader");
}

// Rare use: Mouse cursor, etc.
function void DisplayIconAlways (str Sprite, int ID, fixed X, fixed Y, fixed DelayTime, fixed Alpha) {
    if (CheckFont(Sprite)) {
        SetFont(Sprite);
        HudMessage(s:"A\n"; HUDMSG_ALPHA, ID, CR_UNTRANSLATED, X, Y, DelayTime, Alpha);
        PDA_DefaultFont();
    }
}

function void DisplayIcon (str Sprite, int ID, fixed X, fixed Y, fixed DelayTime, fixed Alpha) {
    if (CheckFont(Sprite)) {
        SetFont(Sprite);
        HudMessage(s:"A\n"; HUDMSG_ALPHA, ID, CR_UNTRANSLATED, X, Y, DelayTime, Alpha);
        PDA_DefaultFont();
    }
    TraceLog("DisplayIcon");
}

function void DisplayIconParallax (str Sprite, int ID, fixed X, fixed Y, fixed DelayTime, fixed Alpha) {
    if (CheckFont(Sprite)) {
        SetFont(Sprite);
        int _yTemp = PDA_Local.scrollingY + Y;
            _yTemp *= NEW_RESOLUTION_Y;
        HudMessage(s:"A\n"; HUDMSG_ALPHA, ID, CR_UNTRANSLATED, X, _yTemp + Y_TOP_EDGE, DelayTime, Alpha);
        PDA_DefaultFont();
    }
    TraceLog("DisplayIconParallax");
}

function void DisplayArmorIcon (str Sprite, int ID, fixed X, fixed Y, fixed Alpha) {
    if (CheckFont(StrParam("%l:", Sprite))) {
        SetFont(StrParam("%l:", Sprite));
        HudMessage(s:"A\n"; HUDMSG_ALPHA, ID, CR_UNTRANSLATED, X, Y, 0, Alpha);
        SetFont(PDA_FONT[mono_font]);
    }
    TraceLog("DisplayArmorIcon");
}

function void HudMessageParallax(str text, int type, int id, int color, fixed x, fixed y, fixed holdTime, fixed alpha) {
    int _xTemp = (PDA_SCREEN_X + x) * NEW_RESOLUTION_X;
    int _yTemp = (PDA_Local.scrollingY * NEW_RESOLUTION_Y) + y;
    fixed _x = _xTemp + X_LEFT_EDGE;
    fixed _y = _yTemp + Y_TOP_EDGE;
    HudMessage(s:text; type, id, color, _x, _y, holdTime, alpha);
    TraceLog("HudMessageParallax");
}

function int CheckPointerInventory (str item, int pn) {
    SetActivator(0, AAPTR_PLAYER1 << pn);
    return CheckInventory(item);
}

function int SetInventory (str Item, int Count) {
    int n = Count - CheckInventory(Item);

    if (n > 0)
        GiveInventory(Item, n);
    else if (n < 0)
        TakeInventory(Item, -n);

    return n;
}

function int checkSpecialArmorTokens(void) {
    return CheckInventory("RLEnclaveSetBonusActive")                 ||
        CheckInventory("PowerRLPrototypeAssaultShieldProtection") ||
        CheckInventory("PowerRLOverchargeSystemProtection")       ||
        CheckInventory("RLCyberneticArmorModdedToken")            ||
        CheckInventory("RLDeathFromAboveSetBonusActive")          ||
        CheckInventory("PowerRLInquisitorsSetBonusProtection");
}

#define checkMonsterKillCount() \
    for (int t = 0; t < DRLA_DIFFICULTYTIERS; t++) { \
        for (int m = 0; m < DRLA_MONSTER_PAGE_MAX; m++) { \
            monsterCheck[t][m] = CheckInventory(StrParam(s:DRLA_Bestiary[t][m][beast_TOKEN],s:"KillCounter")); \
            if (oldCheck[t][m] != monsterCheck[t][m] && oldCheck[t][m] < 2 && monsterCheck[t][m] < 2) { \
                PDA_Local.newEntry[t] = true; \
            } \
        } \
    } \

#define updateOldMonsterKillCount() \
    for (int t = 0; t < DRLA_DIFFICULTYTIERS; t++) { \
        for (int m = 0; m < DRLA_MONSTER_PAGE_MAX; m++) { \
            oldCheck[t][m] = monsterCheck[t][m]; \
        } \
    } \


// int _xTemp = (PDA_SCREEN_X * NEW_RESOLUTION_X) + (x * NEW_RESOLUTION_X);
#define assignButtonParams(a, b) \
    int _xTemp = PDA_SCREEN_X + x; \
    int _yTemp = PDA_Local.scrollingY + y; \
    (a).id = id; \
    (a).x = _xTemp; \
    (a).y = _yTemp; \
    (a).width = width; \
    (a).height = height; \
    (a).label = (b); \

#define CheckBounds(a) \
    PDA_LocalMouse.x >= (a).x - 1 && PDA_LocalMouse.x <= (a).x + (a).width \
    && \
    PDA_LocalMouse.y >= (a).y - 2 && PDA_LocalMouse.y <= (a).y + (a).height \

#define PDA_PlaySound(PDA_Sound, soldier, volume) \
    LocalAmbientSound(!GetCVar("DRLA_PDA_soldier") ? PDA_Sound : soldier, volume); \

#define buttonBoundsDefault(button) \
    if (CheckBounds(button)) { \
        (button).state = button_hovered; \
        PDA_LocalMouse.state = cursor_pointer; \
        if ((button).state != (button).oldState) { \
            PDA_PlaySound("UI/PDA/Select", "pda/soldier", 80); \
        } \
        if (PDA_LocalMouse.action == mouse_click) { \
            PDA_PlaySound("UI/PDA/ChangePage", "pda/soldier", 80); \
            (button).state = button_clicked; \
            PDA_LocalMouse.state = mouse_click; \
        } \
    } else { \
        (button).state = button_none; \
        PDA_Local.playSoundOnce = false; \
        if ((button).state != (button).oldState) { \
            PDA_LocalMouse.state = cursor_default; \
        } \
    } \


// Debuggies

function str stringifyMouseState (int state) {
    switch (state) {
        case mouse_none:
            return "mouse_none"; break;
        case mouse_click:
            return "mouse_click"; break;
        case mouse_hold:
            return "mouse_hold"; break;
        case mouse_back:
            return "mouse_back"; break;
        default:
            return "invalid_mouse_state"; break;
    }
}

function str stringifyButtonState (int state) {
    switch(state) {
        case button_none:
            return "button_none"; break;
        case button_hovered:
            return "button_hovered"; break;
        case button_clicked:
            return "button_clicked"; break;
        default:
            return "invalid_state"; break;
    }
}

