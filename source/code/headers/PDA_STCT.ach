
struct PDAInfo {
    bool active;
    bool pongRunning;

    bool clicked;
    bool playSoundOnce;

    bool stopEquipmentEarly;
    bool dirty;
    bool scrollDirty;

    bool newEntry[5];

    bool armorHax;
    bool hasEquipment;

    int category;
    int prevCategory;
    int page;
    int prevPage;

    int pageMax;
    int ptic; // PDA tics

    int assemblyOffset;
    int currentAssembly;
    int maxAssembliesPer;

    int maxModLimit;
    int scrollYDelta;

    int equipmentId[PDA_EQUIPMENT_TOTAL_MAX];

    fixed textY;
    fixed maxTextY;
    fixed scrollingY;
    fixed oldScrollingY; // Deprecated
    fixed creditsroll;
    fixed equipmentBaseY;
    fixed prevScrollingY;

    str clipRegion;
    str tierColor;
    str detailFetch[8];
    str heading;

}
PDAInfo PDA_Info[MAX_PLAYERS];

struct PDAMouse {
    bool m1;
    bool m2;

    bool scrolling;
    bool moving;

    int x;
    int y;
    int oldX;
    int oldY;
    
    int state;
    int oldState;

    int action;

    int mtic;
}
PDAMouse PDA_Mouse[MAX_PLAYERS];


struct PDAButton {
    int id;

    int width;
    int height;

    int state;
    int oldState;
    int graphicID;
    int graphicFlags;

    int textColor;
    int textID;
    int textFlags;

    // Here we go! Time to make PDA_ButtonLogic the single source of truth for all button actiosn
    int actionID;
    int actionParam;

    fixed x;
    fixed y;
    fixed rawY;

    fixed alpha;

    fixed textX;
    fixed textY;

    fixed finalX;
    fixed finalY;
    fixed scrollY;

    fixed gfxPos[4]; // Contains gfxX, gfxY, xOffset, yOffset
    fixed textPos[4]; // Contains text X, Y, xOffset, yOffset

    str type;
    str textFont;

    str label;
    str graphic;

    str tooltip;
}
PDAButton PDA_Button[MAX_PLAYERS][PDA_BUTTON_MAX];

// I could expand these so they can hold more data...
// Theoretically, I could have it such that index 0 is always the current viewed one. Indices 1-6 are then the existing armors stored.
// Or instead just compress these into one

struct PDA_EquipmentData {
    int type; // armor, backpack, boots
    int buttonID;

    str langEntry;
    str name;
    str graphic;
    str attr;
    str desc;
    str val;
    str tooltip;

    str res;
}
// 0 - queried item
// 1 - worn armor
// 2 - worn backpack
// 3 - worn boots
// 4 5 6 7 - stashed
PDA_EquipmentData _ed[MAX_PLAYERS][PDA_EQUIPMENT_TOTAL_MAX];

