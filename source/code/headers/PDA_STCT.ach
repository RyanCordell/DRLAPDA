
struct PDAInfo {
    bool active;
    bool pongRunning;

    bool clicked;
    bool playSoundOnce;

    bool stopEquipmentEarly;
    bool dirty;
    bool scrollDirty;

    bool newEntry[5];

    bool armorHax;

    int category;
    int prevCategory;
    int page;
    int prevPage;

    int pageMax;
    int ptic; // PDA tics

    int assemblyOffset;
    int currentAssembly;
    int maxAssembliesPer;

    int maxModLimit;
    int scrollYDelta;

    int equipmentLimit;
    int equipmentId[PDA_EQUIPMENT_TOTAL_MAX];

    fixed textY;
    fixed maxTextY;
    fixed scrollingY;
    fixed oldScrollingY; // Deprecated
    fixed creditsroll;
    fixed equipmentBaseY;
    fixed prevScrollingY;

    str clipRegion;
    str tierColor;
    str detailFetch[8];
    str heading;

}
PDAInfo PDA_Info[MAX_PLAYERS];

struct PDAMouse {
    bool m1;
    bool m2;

    bool scrolling;
    bool moving;

    int x;
    int y;
    int oldX;
    int oldY;
    
    int state;
    int oldState;

    int action;

    int mtic;
}
PDAMouse PDA_Mouse[MAX_PLAYERS];


struct PDAButton {
    int id;

    int width;
    int height;

    int state;
    int oldState;
    int graphicID;
    int graphicFlags;

    int textColor;
    int textID;
    int textFlags;

    // Here we go! Time to make PDA_ButtonLogic the single source of truth for all button actiosn
    int actionID;
    int actionParam;

    fixed x;
    fixed y;
    fixed rawY;

    fixed alpha;

    fixed textX;
    fixed textY;

    fixed finalX;
    fixed finalY;
    fixed scrollY;

    fixed gfxPos[4]; // Contains gfxX, gfxY, xOffset, yOffset
    fixed textPos[4]; // Contains text X, Y, xOffset, yOffset

    str type;
    str textFont;

    str label;
    str graphic;

    str tooltip;
}
PDAButton PDA_Button[MAX_PLAYERS][PDA_BUTTON_MAX];

struct PDA_ArmorData {
    str armorRes;
    str langEntry;
    str name;
    str graphic;
    str armorAttr;
    str armorDesc;
    str armorVal;
    str tooltip;
}
PDA_ArmorData _ad[MAX_PLAYERS][1];

struct PDA_BackpackData {
    str name;
    str graphic;
    str tooltip;
    str backpackVal;
}
PDA_BackpackData _bpd[MAX_PLAYERS][1];

struct PDA_BootsData {
    str name;
    str graphic;
    str bootsAttr;
    str bootsDesc;
    str bootsVal;
    str langEntry;
    str tooltip;
}
PDA_BootsData _bd[MAX_PLAYERS][1];
