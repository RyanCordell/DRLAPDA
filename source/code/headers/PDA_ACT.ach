
switch (thisButton.actionID) {
    case action_navigate:
        // if (!inCategory) {
        //     if (buttonType != "equipment") PDA_SetCategory(page);
        //
        //     if (PDA_Local.category != PDA_ASSEMBLY_DETAIL) {
        //         if (buttonType != "equipment") PDA_SetPage(1);
        //     }
        // } else {
        //     // I wonder why I'm checking for the page being above 0?
        //     if (PDA_Local.category != 0 && PDA_Local.page >= 0) {
        //         if (buttonType != "equipment") {
        //             PDA_SetPage(page);
        //             PDA_ResetScroll();
        //         }
        //     }
        // }
        if (buttonType == "equipment") break;
        // For the main PDA menu
        bool inCategory = (PDA_Local.category != PDA_MENU);
        if (!inCategory) {
            PDA_SetCategory(thisButton.actionParam);

            if (PDA_Local.category != PDA_ASSEMBLY_DETAIL) {
                PDA_SetPage(1);
            }
        } else {
            // I wonder why I'm checking for the page being above 0?
            if (PDA_Local.page >= 0) {
                PDA_SetPage(thisButton.actionParam);
                PDA_ResetScroll();
            }
        }
        break;
    case action_toggle_display:
        switch(thisButton.actionParam) {
            case 1: // armor
                if (localEqBoolField != 1) localEqBoolField = 1;
                break;
            case 2: // backpack
                if (localEqBoolField != 2) localEqBoolField = 2;
                break;
            case 3: // boots
                if (localEqBoolField != 4) localEqBoolField = 4;
                break;
        }

        localShowArmor    = (localEqBoolField & 1);
        localShowBackpack = (localEqBoolField & 1<<1);
        localShowBoots    = (localEqBoolField & 1<<2);
        break;
    case action_show_equipment_detail:
        // Lead param dictates the equipment type..
        // Stored param dictates the index to use
        int leadParam = extractDigit(thisButton.actionParam, 2);
        int storedParam = extractDigit(thisButton.actionParam, 1);

        if (localHasEquippedArmor) {
            PDA_Local.detailFetch[0] = "armor";
            // why am I not just assigning the worn_armor directly to query?
            // localEquipmentDataStored[EQUIPPED_QUERY] = setupArmorData(checkSpecialArmorTokens(), localEquipmentDataStored[EQUIPPED_WORN_ARMOR].langEntry);
            localEquipmentDataStored[EQUIPPED_QUERY] = localEquipmentDataStored[EQUIPPED_WORN_ARMOR];
        }

        if (localHasEquippedBackpack) {
            PDA_Local.detailFetch[0] = "backpack";
            // localEquipmentDataStored[EQUIPPED_QUERY] = setupBackpackData();
            localEquipmentDataStored[EQUIPPED_QUERY] = localEquipmentDataStored[EQUIPPED_WORN_BACKP];
        }

        if (localHasEquippedBoots) {
            PDA_Local.detailFetch[0] = "boots";
            // localEquipmentDataStored[EQUIPPED_QUERY] = setupBootsData(localEquipmentDataStored[EQUIPPED_WORN_BOOTS].langEntry);
            localEquipmentDataStored[EQUIPPED_QUERY] = localEquipmentDataStored[EQUIPPED_WORN_BOOTS];
        }

        switch(leadParam) {
            case 1:
                PDA_Local.detailFetch[0] = "armor";
                localEquipmentDataStored[EQUIPPED_QUERY] = localEquipmentDataStored[storedParam];
                break;
            case 2:
                PDA_Local.detailFetch[0] = "backpack";
                localEquipmentDataStored[EQUIPPED_QUERY] = localEquipmentDataStored[storedParam];
                break;
            case 3:
                PDA_Local.detailFetch[0] = "boots";
                localEquipmentDataStored[EQUIPPED_QUERY] = localEquipmentDataStored[storedParam];
                break;
        }

        PDA_SetCategory(PDA_EQUIPMENT_DETAIL);
        PDA_Local.stopEquipmentEarly = true;
        break;
    case action_open_assembly:
        if (thisButton.actionParam != -1) {
            PDA_Local.detailFetch[0] = stringArray[ASSEMBLY_DIM][thisButton.actionParam];
            if (StrCmp(PDA_Local.detailFetch[0], "") != 0) {
                PDA_SetCategory(PDA_ASSEMBLY_DETAIL);
            }
        }
        break;
    case action_open_monster_page:
        if (thisButton.actionParam >= 1000) {
            int difficultyTier = extractDigit(thisButton.actionParam, 4) - 1;
            // Currently a safe enough bet since DRLA monsters are in the double digit range
            int bestiaryIndex = thisButton.actionParam % 10;

            str beastActor = DRLA_Bestiary[difficultyTier][bestiaryIndex][beast_ACTOR_NAME];
            str beastLang  = DRLA_Bestiary[difficultyTier][bestiaryIndex][beast_LANG_POINTER];

            bestiaryInfo.actor       = beastActor;
            bestiaryInfo.token       = beastLang;
            bestiaryInfo.name        = StrParam("%s:_NAME",       beastLang);
            bestiaryInfo.icon        = StrParam("%s:_ICON",       beastLang);
            bestiaryInfo.health      = StrParam("%s:_HEALTH",     beastLang);
            bestiaryInfo.resistances = StrParam("%s:_RESISTANCE", beastLang);
            bestiaryInfo.misc        = StrParam("%s:_MISC",       beastLang);
            bestiaryInfo.killtoken   = StrParam("%s:KillCounter", beastActor);
            bestiaryInfo.count       = CheckPointerInventory(bestiaryInfo.killtoken, PlayerNumber());

            PDA_Local.detailFetch[0] = bestiaryInfo.actor;
        } else {
            PDA_Local.detailFetch[0] = "null";
        }
        PDA_SetCategory(PDA_BESTIARY_DETAIL);
        break;
}
