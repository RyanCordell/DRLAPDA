// header
PDA_ButtonHandler(TAB1, true, 1, NO_TOOLTIP, B_FUNCTIONAL, B_NO_CLEAR);
PDA_ButtonHandler(TAB2, true, 2, NO_TOOLTIP, B_FUNCTIONAL, B_NO_CLEAR);
PDA_ButtonHandler(TAB3, true, 3, NO_TOOLTIP, B_FUNCTIONAL, B_NO_CLEAR);

if (PDA_LocalMouse.action == mouse_back) {
    PDA_SetCategory(PDA_MENU);
    PDA_SetPage(1);
}

// body
for (int ti = 0, li = 1; ti <= PDA_Local.maxAssembliesPer; ti+=2, li+=2) {
    int aoff       = (PDA_Local.assemblyOffset - 1 < 0) ? 0 : (PDA_Local.assemblyOffset - 1);
    str actorToken = stringArray[ASSEMBLY_DIM][ti + aoff];
    int id         = PDA_ASSEMBLY_ID_END - (ti - 1); // index - 1 to account for message id

    if (ti + 2 >= advanced_offset && PDA_Local.assemblyOffset < advanced_offset) continue;
    if (ti + 2 >= master_offset   && PDA_Local.assemblyOffset < master_max     ) continue;

    int _incat = false;
    int _catpage = PDA_ASSEMBLY_DETAIL;
    if (!PDA_CheckPlayer1Inventory(actorToken) || !CheckInventory(actorToken)) {
        _incat = true;
        _catpage = PDA_Local.page;
    }

    PDA_ButtonHandler(id, _incat, _catpage, "", false, false);
}

if (PDA_Local.page > 1) {
    PDA_ButtonHandler(PDA_PREV_PAGE, true, PDA_Local.page - 1, NO_TOOLTIP, B_FUNCTIONAL, B_NO_CLEAR);
}
if (PDA_Local.page < 3) {
    PDA_ButtonHandler(PDA_NEXT_PAGE, true, PDA_Local.page + 1, NO_TOOLTIP, B_FUNCTIONAL, B_NO_CLEAR);
}
