// header
PDA_ButtonHandler(TAB1, NO_TOOLTIP, B_FUNCTIONAL, B_NO_CLEAR);
PDA_ButtonHandler(TAB2, NO_TOOLTIP, B_FUNCTIONAL, B_NO_CLEAR);
PDA_ButtonHandler(TAB3, NO_TOOLTIP, B_FUNCTIONAL, B_NO_CLEAR);

if (userWentBack) {
    PDA_SetCategory(PDA_MENU);
    PDA_SetPage(1);
}

PDA_SetupScreenBounds();

// body
for (int ti = 0, li = 1; ti <= PDA_Local.maxAssembliesPer; ti+=2, li+=2) {
    int id = PDA_ASSEMBLY_ID_END - (ti - 1); // index - 1 to account for message id

    if (ti + 2 >= advanced_offset && PDA_Local.assemblyOffset < advanced_offset) continue;
    if (ti + 2 >= master_offset   && PDA_Local.assemblyOffset < master_max     ) continue;

    PDA_ButtonHandler(id, NO_TOOLTIP, B_FUNCTIONAL, B_NO_CLEAR);
}

if (PDA_Local.page > 1) {
    PDA_ButtonHandler(PDA_PREV_PAGE, NO_TOOLTIP, B_FUNCTIONAL, B_NO_CLEAR);
}
if (PDA_Local.page < 3) {
    PDA_ButtonHandler(PDA_NEXT_PAGE, NO_TOOLTIP, B_FUNCTIONAL, B_NO_CLEAR);
}
