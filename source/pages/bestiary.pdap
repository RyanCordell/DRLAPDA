if (userWentBack) {
    if (PDA_Local.page > 1) {
        PDA_SetPage(1);
    } else {
        PDA_SetCategory(PDA_MENU);
        PDA_SetPage(1);
    }
}

switch (PDA_Local.page) {
    case BESTIARY_PAGE_DIFFICULTIES: 
        PDA_ButtonHandler(PDA_BEAST_UV, strparam("%l:\n", "PDA_DIFFICULTY_UV_OR_LOWER") , B_FUNCTIONAL, B_NO_CLEAR);
        PDA_ButtonHandler(PDA_BEAST_NM, strparam("%l:\n", "PDA_DIFFICULTY_NIGHTMARE")   , B_FUNCTIONAL, B_NO_CLEAR);
        PDA_ButtonHandler(PDA_BEAST_TP, strparam("%l:\n", "PDA_DIFFICULTY_TECHNOPHOBIA"), B_FUNCTIONAL, B_NO_CLEAR);
        PDA_ButtonHandler(PDA_BEAST_AG, strparam("%l:\n", "PDA_DIFFICULTY_ARMAGEDDON")  , B_FUNCTIONAL, B_NO_CLEAR);
        PDA_ButtonHandler(PDA_BEAST_EX, strparam("%l:\n", "PDA_DIFFICULTY_EXTRA")       , B_FUNCTIONAL, B_NO_CLEAR);
        break;
    default:
        for (int i = 0; i < DRLA_MONSTER_PAGE_MAX; i++) {
            #define buttonID(a) (PDA_BEASTS_ID_END - (a))

            if (bestiaryInfo.name != " ????") {
                PDA_ButtonHandler(buttonID(i), NO_TOOLTIP, B_FUNCTIONAL, B_NO_CLEAR);

                if (PDA_LocalButton[buttonID(i)].state == button_hovered) {
                    DisplayIcon(CheckFont(bestiaryInfo.icon)
                        ? bestiaryInfo.icon
                        : "EPDAUNK",
                        PDA_INFO2ID, PDA_SCREEN_WIDTH - 30.0 + X_LEFT_EDGE, PDA_SCREEN_Y + 100.0 + Y_TOP_EDGE, 0, 
                        0.2 + pulser(2.0, 0.59)
                    );
                }
            }
        }
        PDA_Local.newEntry[bestiaryInfo.page] = false;
        break;
}
