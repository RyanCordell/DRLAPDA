if (GetCvar("DRLA_specialstarts") != 2) {
    PDA_Local.pageMax = DRLA_GROUPQUANTITY;

    PDA_ButtonHandler(TAB1, NO_TOOLTIP, B_FUNCTIONAL, B_NO_CLEAR);
    PDA_ButtonHandler(TAB2, NO_TOOLTIP, B_FUNCTIONAL, B_NO_CLEAR);
    PDA_ButtonHandler(TAB3, NO_TOOLTIP, B_FUNCTIONAL, B_NO_CLEAR);
    PDA_ButtonHandler(TAB4, NO_TOOLTIP, B_FUNCTIONAL, B_NO_CLEAR);
    PDA_ButtonHandler(TAB5, NO_TOOLTIP, B_FUNCTIONAL, B_NO_CLEAR);
}


if (userWentBack) {
    PDA_SetCategory(PDA_MENU);
    PDA_SetPage(1);
}

if (GetCvar("DRLA_specialstarts") == 2)
{
    PDA_Local.pageMax = 3;

    #define DUKE2X 0.0 + X_LEFT_EDGE
    #define DUKE2Y 0.0 + Y_TOP_EDGE

    switch(PDA_Local.page)
    {
        case 1: DisplayIcon("DN2HLP1", PDA_INFOTOPID - 1, DUKE2X + PDA_SCREEN_X, PDA_SCREEN_Y + DUKE2Y, 0, 1); break;
        case 2: DisplayIcon("DN2HLP2", PDA_INFOTOPID - 1, DUKE2X + PDA_SCREEN_X, PDA_SCREEN_Y + DUKE2Y, 0, 1); break;
        case 3: DisplayIcon("DN2HLP3", PDA_INFOTOPID - 1, DUKE2X + PDA_SCREEN_X, PDA_SCREEN_Y + DUKE2Y, 0, 1); break;
    }

    //SetHudSize(320,200);
}
if (GetCvar("DRLA_specialstarts") != 2)
{
    PDA_SetupScreenBounds();
    int ItemLimit = 0;

    int DRLA_PageOffset;

    #define itemsGfxY 40.0
    #define itemsYOffset (itemsGfxY - itemsGfxY)
    #define itemsSpacing 40.0

    // Ideally, the items here would be set up much like the element Flexbox system works on the internet..
    for (int itemIndex = 0; itemIndex < DRLA_ITEMSMAX; itemIndex++)
    {
        if (ItemLimit < 8)
        {
            if (PDA_Local.page == 1) DRLA_PageOffset = 1;
            if (PDA_Local.page > 1)  DRLA_PageOffset = (8 * (PDA_Local.page - 1) + 1);

            // Item icon
            DisplayIconScrollable(
                StrParam("%l:", DRLA_ItemInfo[itemIndex + DRLA_PageOffset][0]), 
                PDA_ITEMS_END - (ItemLimit+1), 
                PDA_SCREEN_X_SCALED + 55.0 + X_LEFT_EDGE, itemsGfxY + (itemsSpacing * ItemLimit), INF_HOLDTIME, OPAQUE);

            // Item name + desc
            PDA_DrawBodyText(HUDMSG_PLAIN, PDA_ITEMS_END - (ItemLimit+9), CR_UNTRANSLATED, 35.0, itemsYOffset + (itemsSpacing * ItemLimit), INF_HOLDTIME, OPAQUE, B_IS_SCROLLABLE, DEFAULT_ALIGN, DEFAULT_ALIGN,
                l:DRLA_ItemInfo[itemIndex + DRLA_PageOffset][1],
                l:DRLA_ItemInfo[itemIndex + DRLA_PageOffset][2],
                s:"\n"
            );

            ItemLimit++;
        }
    }
}
