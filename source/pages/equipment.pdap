// effectively a substitute for equipment_onhand_draw.pdap

// Header
PDA_ButtonHandler(TAB1, NO_TOOLTIP, B_FUNCTIONAL, B_NO_CLEAR);
PDA_ButtonHandler(TAB2, NO_TOOLTIP, B_FUNCTIONAL, B_NO_CLEAR);

if (userWentBack) {
    PDA_SetCategory(PDA_MENU);
    PDA_SetPage(1);
}

// Body
PDA_SetupScreenBounds();

switch(PDA_Local.page) {
    case EQUIPMENT_PAGE_ONHAND:
        #define armorHandler(eqId) \
            PDA_ButtonHandler(eqId, NO_TOOLTIP, B_FUNCTIONAL, B_NO_CLEAR);

        if (PDA_ScrollableNeedsDraw) {
            SetFont(PDA_FONT[mono_font]);
            if (!PDA_Local.hasEquipment) {
                PDA_DrawBodyText(HUDMSG_PLAIN, PDA_NOEQID, CR_UNTRANSLATED, 10.0, 50.0, INF_HOLDTIME, OPAQUE, B_NOT_SCROLLABLE, DEFAULT_ALIGN, DEFAULT_ALIGN, s:"No equipment detected");
            } else {
                deleteNoEquipmentMessage();
            }
        }

        // All handled separately for a good reason
        if (localHasEquippedArmor) {
            armorHandler(PDA_Local.equipmentId[EQUIPPED_WORN_ARMOR]);
        }

        if (localHasEquippedBackpack) {
            armorHandler(PDA_Local.equipmentId[EQUIPPED_WORN_BACKP]);
        }

        if (localHasEquippedBoots) {
            armorHandler(PDA_Local.equipmentId[EQUIPPED_WORN_BOOTS]);
        }

        // Afterwards, all the stashed ones/in inventory
        for (int stshId = EQUIPPED_WORN_BOOTS + 1; stshId < PDA_EQUIPMENT_TOTAL_MAX; ++stshId) {
            if (localEquipmentDataStored[stshId].langEntry != "") {
                armorHandler(PDA_Local.equipmentId[stshId]);
            }
        }

        PDA_DefaultFont();
        break;
    case EQUIPMENT_PAGE_INFO:
        #include "./subpage/equipment_equipped_draw.pdap"
        break;
}
