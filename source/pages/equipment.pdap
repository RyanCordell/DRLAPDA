// Header
PDA_ButtonHandler(TAB1, true, 1, NO_TOOLTIP, B_FUNCTIONAL, B_NO_CLEAR);
PDA_ButtonHandler(TAB2, true, 2, NO_TOOLTIP, B_FUNCTIONAL, B_NO_CLEAR);

if (PDA_LocalMouse.action == mouse_back) {
    PDA_SetCategory(PDA_MENU);
    PDA_SetPage(1);
}

// Body
// belongs to equipment_onhand_draw.pdap
#define equipmentButton PDA_LocalButton[PDA_Local.equipmentId]

#define someCheck() \
PDA_ButtonHandler(PDA_Local.equipmentId, true, 1, NO_TOOLTIP, B_FUNCTIONAL, B_NO_CLEAR); \
deleteNoEquipmentMessage(); \
// if (StrCmp(equipmentButton.tooltip, "") != 0 && CheckBounds(equipmentButton) && PDA_Local.page != EQUIPMENT_PAGE_INFO) { \
//     PDA_SetupFloatingTooltip("PTIP", equipmentButton.tooltip); \
// } \

switch(PDA_Local.page) {
    case EQUIPMENT_PAGE_ONHAND:
        PDA_DrawBodyText(HUDMSG_PLAIN, PDA_NOEQID, CR_UNTRANSLATED, 10.0, 50.0, INF_HOLDTIME, OPAQUE, B_NOT_SCROLLABLE, DEFAULT_ALIGN, DEFAULT_ALIGN, s:"No equipment detected");

        // Note to future self: don't try to merge these two ifs for cleanliness sake. Won't work the way you wish it would.
        // log("eq armor: %s: | eq boots: %s:", DRLA_Equipment_List[localArmorIndex][armor_ACTOR], DRLA_Equipment_List[localBootsIndex][armor_ACTOR]);
        if (localHasArmor) {
            someCheck();
        }

        if (localHasBoots) {
            someCheck();
        }

        // Stashed armors
        for (int armorIndex = 0; armorIndex < DRLA_EQUIPMENT_MAX; armorIndex++) {
            log("eqId: %d:", PDA_Local.equipmentId);
            #define _armorToken DRLA_Equipment_List[armorIndex][armor_TOKEN]
            if (PDA_Local.stopEquipmentEarly) {
                break;
            }

            if (CheckInventory(StrParam("%s:Pickup", _armorToken))) {
                log("equipment: %s:", _armorToken);
                deleteNoEquipmentMessage();
                // TODO: Maybe someday I can have this lead to a separate Equipment Detail page
                // The source seems to say it was kind of already a thing? I have no idea..
                PDA_ButtonHandler(PDA_Local.equipmentId, true, 1, NO_TOOLTIP, B_ONLY_VISUAL, B_NO_CLEAR);
            }
        }
        PDA_DefaultFont();
        break;
    case EQUIPMENT_PAGE_INFO:
        #include "./subpage/equipment_equipped_draw.pdap"
        break;
}
