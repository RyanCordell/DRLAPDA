PDA_ButtonHandler(TAB1, true, 1, NO_TOOLTIP, B_FUNCTIONAL, B_NO_CLEAR);
PDA_ButtonHandler(TAB2, true, 2, NO_TOOLTIP, B_FUNCTIONAL, B_NO_CLEAR);
PDA_ButtonHandler(TAB3, true, 3, NO_TOOLTIP, B_FUNCTIONAL, B_NO_CLEAR);
PDA_SetupScreenBounds();

if (PDA_LocalMouse.action == mouse_back) {
    PDA_SetCategory(PDA_MENU);
    PDA_SetPage(1);
}

if (stricmp(player_weapon[player_weapon_current], "None") != 0) {
    switch (PDA_Local.page) {
        case WEAPON_PAGE_STORY:
            #include "../../pages/subpage/weapons_story_logic.pdap"
            #include "../../pages/subpage/weapons_story_draw.pdap"
            break;
        case WEAPON_PAGE_MODPACK_EFFECTS:
            #include "../../pages/subpage/weapons_mods_logic.pdap"
            #include "../../pages/subpage/weapons_mods_draw.pdap"
            break;
        case WEAPON_PAGE_ARTIFACT_EFFECTS:
            #include "../../pages/subpage/weapons_artifacts_logic.pdap"
            #include "../../pages/subpage/weapons_artifacts_draw.pdap"
            break;
    }
}

