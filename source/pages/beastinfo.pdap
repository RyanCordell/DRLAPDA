if (userWentBack) {
    PDA_SetCategory(PDA_BESTIARY);
    PDA_SetPage(PDA_Local.prevPage);
}

if (StrCmp(PDA_Local.detailFetch[0], "null") != 0) {
    // Monster icon
    DisplayIconScrollable(StrParam("%l:", bestiaryInfo.icon), PDA_INFO2ID, (int)(PDA_SCREEN_X_SCALED + PDA_SCREEN_WIDTH_SCALED - 60.0) + X_LEFT_EDGE, (int)(PDA_BODY_Y + 20.0), 0, 0.8);

    // SetFont(PDA_FONT[mono_font]);
    PDA_DrawBodyText(HUDMSG_PLAIN, PDA_INFO3ID, CR_UNTRANSLATED, 0.0, 10.0, INF_HOLDTIME, OPAQUE, B_IS_SCROLLABLE, DEFAULT_ALIGN, DEFAULT_ALIGN,
        s:"\cdName:\c- ",l:bestiaryInfo.name,s:"\n",
        s:"\cdNo. of Kills:\c- ",i:bestiaryInfo.count,s:"\n",
        s:"\cdHealth:\c- ",l:bestiaryInfo.health,s:"\n",
        s:"\cdResistances:\c- \n",l:bestiaryInfo.resistances,s:"\n",
        s:"\cdDrops and misc info:\c- \n",l:bestiaryInfo.misc,s:"\n"
    );
} else {
    // SetFont(PDA_FONT[mono_font]);
    PDA_DrawBodyText(HUDMSG_PLAIN, PDA_INFO3ID, CR_UNTRANSLATED, 0.0, 10.0, INF_HOLDTIME, OPAQUE, B_IS_SCROLLABLE, DEFAULT_ALIGN, DEFAULT_ALIGN,
        l:"PDA_BESTIARY_DEFAULT_NAME",s:"\n",
        l:"PDA_BESTIARY_DEFAULT_KILLS",s:"\n",
        l:"PDA_BESTIARY_DEFAULT_HEALTH",s:"\n",
        l:"PDA_BESTIARY_DEFAULT_RESISTANCES",s:"\n",
        l:"PDA_BESTIARY_DEFAULT_DESC",s:"\n"
    );
}

