// Header buttons
PDA_ButtonHandler(TAB1, true, 1, NO_TOOLTIP, B_FUNCTIONAL, B_NO_CLEAR);
PDA_ButtonHandler(TAB2, true, 2, NO_TOOLTIP, B_FUNCTIONAL, B_NO_CLEAR);

#define PDA_LocalPlayer PDA_Class[PlayerNumber()]

if (PDA_LocalMouse.action == mouse_back) {
    PDA_SetCategory(PDA_MENU);
    PDA_SetPage(1);
}

if (GetActorClass(0) != "None") {
    if (stricmp(PDA_LocalPlayer[pda_class_icon], "PDA_", 4) == 0) {
        PDA_LocalPlayer[pda_class_icon] = "PPDAUNK";
    }

    if (PDA_ScrollableNeedsDraw) {
        PDA_SetupScreenBounds();
        DisplayIcon(PDA_LocalPlayer[pda_class_icon], PDA_INFOID,
            (int)(PDA_SCREEN_WIDTH_SCALED + 0.0) + X_RIGHT_EDGE,
            (int)(PDA_SCROLLABLE_BODY_HEIGHT - 6.0),
            INF_HOLDTIME, 0.45);

        int array_access_index = pda_class_abilities;

        PDA_DefaultFont();
        switch(PDA_Local.page) {
            case CLASSES_PAGE_PERKS:
                array_access_index = pda_class_abilities;
                break;
            case CLASSES_PAGE_STORY:
                array_access_index = pda_class_story;
                break;
        }

        PDA_DrawBodyText(HUDMSG_PLAIN, PDA_INFO2ID, CR_UNTRANSLATED,
            0.0, 0.0, INF_HOLDTIME, OPAQUE, B_IS_SCROLLABLE, DEFAULT_ALIGN, DEFAULT_ALIGN,
            s:"\cd",l:PDA_LocalPlayer[pda_class_name], s:"\c-\n\n",
            l:PDA_LocalPlayer[array_access_index]
        );
    }
}
// // Get rid of it once we're done.
