// Armor / Boots / Suit display
fixed y          = 0.0;
fixed initialY   = 30.0;
const int height = 16;
int width        = 60;

bool PDA_ManyHax    = false;
// int pdaStrTrimValue = 0;

const fixed inAlpha = 0.7;
const fixed playerIconX = PDA_SCREEN_X + 20.0 + X_LEFT_EDGE;

DisplayIconScrollable("PDAPLYR", PDA_PLYR_ICON, playerIconX, 40.0, INF_HOLDTIME, OPAQUE);

localShowArmor    = (localEqBoolField & 1);
localShowBoots    = (localEqBoolField & 1<<1);
localShowBackpack = (localEqBoolField & 1<<2);

if (localHasArmor) {
    DisplayIconScrollable("PDAPARM", PDA_PLAYER_BODY_ICON, playerIconX, 40.0, 0.0, show_equipment[equipment_armor][PlayerNumber()] ? 1.0 : 0.5);

    // TODO: move to _logic
    PDA_LocalButton[PDA_PLAYER_ARMOR_ICON] = PDA_DisplayArmor(PDA_PLAYER_ARMOR_ICON, ARMOR_DATA, playerIconX + 35.0, 20.0, height, localShowArmor ? pulser(2.0, 0.8) : inAlpha);
}

if (localHasBackpack) {
    DisplayIconScrollable("PDAPBCK", PDA_PLYR_ICON - 2, playerIconX, 40.0, 0.0, show_equipment[equipment_backpack][PlayerNumber()] ? 1.0 : 0.5);

    // TODO: move to _logic
    PDA_LocalButton[PDA_PLAYER_BACKPACK_ICON] = PDA_DisplayArmor(PDA_PLAYER_BACKPACK_ICON, BACKPACK_DATA, playerIconX + 33.0, 45.0, height, localShowBackpack ? pulser(2.0, 0.8) : inAlpha);

}

if (localHasBoots) {
    DisplayIconScrollable("PDAPBTS", PDA_PLYR_ICON - 3, playerIconX, 40.0, 0.0, show_equipment[equipment_boots][PlayerNumber()] ? 1.0 : 0.5);

    // TODO: move to _logic
    PDA_LocalButton[PDA_PLAYER_BOOTS_ICON] = PDA_DisplayArmor(PDA_PLAYER_BOOTS_ICON, BOOTS_DATA, playerIconX + 30.0, 70.0, height, localShowBoots ? pulser(2.0, 0.8) : inAlpha);
}

//armorDesc =  StrParam("PDA_ARMOR_%s:_DESC", StrTrim(GetArmorInfo(ARMORINFO_CLASSNAME),2,pdaStrTrimValue));

str equipment_set_name        = "N/A\n",
    equipment_set_description = "\n\n";

// Armor
for (int setIndex = 0; setIndex < DRLA_ARMORSETMAX; setIndex++) {
    if (CheckInventory(DRLA_ArmorSetList[setIndex])) {
        if (CheckInventory("RLEnclaveSetBonusActive") && CheckInventory("RLNuclearWeaponSetBonusActive"))
            PDA_ManyHax = true;

        str trimmedList = strTrim(DRLA_ArmorSetList[setIndex],2,0);

        equipment_set_name = StrParam("%l:\n\n", (PDA_ManyHax)
            ? "PDA_ARMOR_NuclearWeaponSetBonusActive_equipment_set_name"
            : StrParam("PDA_ARMOR_%s:_equipment_set_name", trimmedList));
        equipment_set_description = StrParam("%l:\n\n", (PDA_ManyHax)
            ? "PDA_ARMOR_NuclearWeaponSetBonusActive_equipment_set_description"
            : StrParam("PDA_ARMOR_%s:_equipment_set_description", trimmedList));
    }
}

str enclaveequipment_set_name = (PDA_ManyHax) ? StrParam("%l:\n\n", "PDA_ARMOR_EnclaveSetBonusActive_equipment_set_name") : "";
str enclaveequipment_set_description = (PDA_ManyHax) ? StrParam("%l:\n\n", "PDA_ARMOR_EnclaveSetBonusActive_equipment_set_description") : "";

SetFont(PDA_FONT[mono_font]);

if (localShowArmor && localHasArmor) {
    PDA_DrawBodyText(HUDMSG_PLAIN, PDA_INFO3ID, CR_UNTRANSLATED, 10.0, 140.0, INF_HOLDTIME, OPAQUE, B_IS_SCROLLABLE, DEFAULT_ALIGN, DEFAULT_ALIGN,
        s:"\cgARMOR\c-\n",
        s:"\crProtection:\c-\n",
        l:localArmorData.armorVal,
        s:"\crResistances:\c-\n",
        l:StrParam("%l:\n", localArmorData.armorRes),
        s:"\crAttributes:\c-\n",
        l:StrParam("%l:\n\n", localArmorData.armorAttr),
        s:"\crDescription:\c-\n",
        s:" ",
        l:StrParam(" %l:\n\n", localArmorData.armorDesc),
        s:"\crSet bonus:\c-\n",
        s:" ",
        l:enclaveequipment_set_name,
        s:" ",
        l:enclaveequipment_set_description,
        s:" ",
        l:equipment_set_name,
        s:" ",
        l:equipment_set_description
    );
} else if (localShowBoots && localHasBoots) {
    PDA_DrawBodyText(HUDMSG_PLAIN, PDA_INFO3ID, CR_UNTRANSLATED, 10.0, 140.0, INF_HOLDTIME, OPAQUE, B_IS_SCROLLABLE, DEFAULT_ALIGN, DEFAULT_ALIGN,
        s:"\cgBOOTS\c-\n",
        s:"\crProtection:\c-\n",
        l:localBootsData.bootsVal,
        s:"\crAttributes:\c-\n",
        l:StrParam("%l:\n", localBootsData.bootsAttr),
        s:"\crDescription:\c-\n",
        l:StrParam("%l:\n", localBootsData.bootsDesc)
    );
} else if (localShowBackpack && localHasBackpack) {
    PDA_DrawBodyText(HUDMSG_PLAIN, PDA_INFO3ID, CR_UNTRANSLATED, 10.0, 140.0, INF_HOLDTIME, OPAQUE, B_IS_SCROLLABLE, DEFAULT_ALIGN, DEFAULT_ALIGN,
        s:"\cgBACKPACK\c-\n",
        s:"\crDescription:\c-\n",
        l:localBackpackData.backpackVal
    );
}
