// We don't REALLY need these anymore, but..
if (localHasArmor) {
    deleteNoEquipmentMessage();
    // chekyWecky(worn_armor_id)
}

if (localHasBoots) {
    deleteNoEquipmentMessage();
    // chekyWecky(worn_boots_id)
}

// Stashed armors
for (int armorIndex = 0, eqId = stashed_id_1; armorIndex < DRLA_EQUIPMENT_MAX; armorIndex++) {
    if (PDA_Local.stopEquipmentEarly) break;

    if (CheckInventory(StrParam("%s:Pickup", DRLA_Equipment_List[armorIndex][armor_TOKEN]))) {
        deleteNoEquipmentMessage();

        if (StrCmp(_armorToken,StrParam("%s:Boots", StrTrim(_armorToken,0,5))) != 0) {
            PDA_LocalButton[PDA_Local.equipmentId[eqId]].actionParam = 1;
        } else {
            PDA_LocalButton[PDA_Local.equipmentId[eqId]].actionParam = 2;
        }

        eqId++;
    }
}

