if (PDA_LocalMouse.action == mouse_back) {
    PDA_SetCategory(PDA_MENU);
    PDA_SetPage(1);
}

// Note to future self: don't try to merge these first 5 lines for cleanliness sake. Won't work the way you wish it would.
if (localHasArmor) {
    PDA_ButtonHandler(PDA_Local.equipmentId, true, 1, "", false, false);

    PDA_LocalButton[PDA_Local.equipmentId].alpha = pulser(2.0, 0.8);
    
    if (CheckBounds(PDA_LocalButton[PDA_Local.equipmentId]) && StrCmp(PDA_LocalButton[PDA_Local.equipmentId].tooltip, "") != 0 && PDA_Local.page != EQUIPMENT_PAGE_INFO) {
        PDA_SetupFloatingTooltip("PTIP", PDA_LocalButton[PDA_Local.equipmentId].tooltip);
        PDA_LocalButton[PDA_Local.equipmentId].alpha = 1.0;
    }

    switch (PDA_LocalButton[PDA_Local.equipmentId].state) {
        case button_clicked:
            PDA_Local.detailFetch[0] = "armor";
            setupArmorDataOverride(checkSpecialArmorTokens(), localArmorData.langEntry);
            PDA_SetCategory(PDA_ARMOR_DETAIL);
            break;
    }
}

if (localHasBoots) {
    PDA_ButtonHandler(PDA_Local.equipmentId, true, 1, "", false, false);

    PDA_LocalButton[PDA_Local.equipmentId].alpha = pulser(2.0, 0.8);

    if (CheckBounds(PDA_LocalButton[PDA_Local.equipmentId]) && StrCmp(PDA_LocalButton[PDA_Local.equipmentId].tooltip, "") != 0 && PDA_Local.page != EQUIPMENT_PAGE_INFO) {
        PDA_SetupFloatingTooltip("PTIP", PDA_LocalButton[PDA_Local.equipmentId].tooltip);
        PDA_LocalButton[PDA_Local.equipmentId].alpha = 1.0;
    }
    
    switch (PDA_LocalButton[PDA_Local.equipmentId].state) {
        case button_clicked:
            PDA_Local.detailFetch[0] = "boots";
            setupBootsDataOverride(localBootsData.langEntry);
            PDA_SetCategory(PDA_ARMOR_DETAIL);
            break;
    }
}

// Stashed armors
for (int armorIndex = 0; armorIndex < DRLA_ARMORMAX; armorIndex++) {
    #define _armorToken DRLA_ArmorList[armorIndex][armor_TOKEN]

    if (PDA_Local.stopEquipmentEarly) break;

    if (CheckInventory(StrParam("%s:Pickup", _armorToken))) {
        switch (PDA_LocalButton[PDA_Local.equipmentId].state) {
            case button_clicked:
                if (StrCmp(_armorToken,StrParam("%s:Boots", StrTrim(_armorToken,0,5))) != 0) {
                    PDA_Local.detailFetch[0] = "armor";
                    setupArmorDataOverride(checkSpecialArmorTokens(), localArmorData.langEntry);
                } else {
                    PDA_Local.detailFetch[0] = "boots";
                    setupBootsDataOverride(localBootsData.langEntry);
                }
                PDA_SetCategory(PDA_ARMOR_DETAIL);
                PDA_Local.stopEquipmentEarly = true;
                break;
        }
        PDA_ButtonHandler(PDA_Local.equipmentId, true, 1, "", false, false);
    }
}
