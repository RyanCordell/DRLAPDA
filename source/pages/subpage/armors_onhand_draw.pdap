
// Funny that I opted to do this instead of just declaring the message outright..
PDA_DrawBodyText(HUDMSG_PLAIN, PDA_NOEQID, CR_UNTRANSLATED, ARM_X, 50.0, INF_HOLDTIME, OPAQUE, B_NOT_SCROLLABLE, DEFAULT_ALIGN, DEFAULT_ALIGN, s:"No equipment detected");

// Note to future self: don't try to merge these first 5 lines for cleanliness sake. Won't work the way you wish it would.
// Note: The pulsers won't animate here, but instead, in _logic.
if (localHasArmor) {
    deleteNoEquipmentMessage();

    PDA_LocalButton[PDA_Local.equipmentId] = PDA_DisplayArmor(PDA_Local.equipmentId, ARMOR_DATA, ARM_X, armorY, ARM_HEIGHT, 1.0);

    if (StrCmp(PDA_LocalButton[PDA_Local.equipmentId].tooltip, "") != 0 && CheckBounds(PDA_LocalButton[PDA_Local.equipmentId]) && PDA_Local.page != EQUIPMENT_PAGE_INFO) {
        PDA_SetupFloatingTooltip("PTIP", PDA_LocalButton[PDA_Local.equipmentId].tooltip);
    }
}

if (localHasBoots) {
    deleteNoEquipmentMessage();

    PDA_LocalButton[PDA_Local.equipmentId] = PDA_DisplayArmor(PDA_Local.equipmentId, BOOTS_DATA, ARM_X, armorY, ARM_HEIGHT, 1.0);

    if (StrCmp(PDA_LocalButton[PDA_Local.equipmentId].tooltip, "") != 0 && CheckBounds(PDA_LocalButton[PDA_Local.equipmentId]) && PDA_Local.page != EQUIPMENT_PAGE_INFO) {
        PDA_SetupFloatingTooltip("PTIP", PDA_LocalButton[PDA_Local.equipmentId].tooltip);
    }
}

// Stashed armors
for (int armorIndex = 0; armorIndex < DRLA_ARMORMAX; armorIndex++) {
    if (CheckInventory(armorPickupCheck)) {
        deleteNoEquipmentMessage();

        if (StrCmp(_armorToken, StrParam("%s:Boots", StrTrim(_armorToken,0,5))) != 0) {
            PDA_LocalButton[PDA_Local.equipmentId] = PDA_DisplayArmorOverride(PDA_Local.equipmentId, localArmorData, ARM_X, armorY, ARM_HEIGHT, 0.6);
        } else {
            PDA_LocalButton[PDA_Local.equipmentId] = PDA_DisplayBootsOverride(PDA_Local.equipmentId, localBootsData, ARM_X, armorY, ARM_HEIGHT, 0.6);
        }
    }
}
PDA_DefaultFont();
