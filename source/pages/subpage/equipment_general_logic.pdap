#define ARM_X 10.0
#define ARM_GAP 4

#define wornEquipmentButton(a) PDA_LocalButton[PDA_Local.equipmentId[(a)]]

// Header
PDA_LocalButton[TAB1] = PDA_CreateTab(TAB1, "1", 1, "PTAB", PDA_TAB_START_X  );
PDA_LocalButton[TAB2] = PDA_CreateTab(TAB2, "2", 2, "PTAB", PDA_TAB_NEXT_X(1));

// Body
fixed armorY = PDA_Local.equipmentBaseY;
PDA_Local.stopEquipmentEarly = false;

// Note to future self: don't try to merge these ifs for cleanliness sake. Won't work the way you wish it would.
// TODO: Do X changes when on page 2
if (localHasEquippedArmor) {
    armorY += ARM_HEIGHT + ARM_GAP;
    wornEquipmentButton(EQUIPPED_WORN_ARMOR) = PDA_DisplayArmor(PDA_Local.equipmentId[EQUIPPED_WORN_ARMOR], ARMOR_DATA, EQUIPPED_WORN_ARMOR, ARM_X, armorY, ARM_HEIGHT, 1.0);
}

// TODO: fix this not being cleared on scroll
// if (localHasEquippedBackpack) {
//     armorY += ARM_HEIGHT + ARM_GAP;
//     wornEquipmentButton(EQUIPPED_WORN_BACKP) = PDA_DisplayArmor(PDA_Local.equipmentId[EQUIPPED_WORN_BACKP], BACKPACK_DATA, EQUIPPED_WORN_BACKP, ARM_X, armorY, ARM_HEIGHT, 1.0);
// }

if (localHasEquippedBoots) {
    armorY += ARM_HEIGHT + ARM_GAP;
    wornEquipmentButton(EQUIPPED_WORN_BOOTS) = PDA_DisplayArmor(PDA_Local.equipmentId[EQUIPPED_WORN_BOOTS], BOOTS_DATA, EQUIPPED_WORN_BOOTS, ARM_X, armorY, ARM_HEIGHT, 1.0);
}

for (int stshId = EQUIPPED_WORN_BOOTS + 1; stshId < PDA_EQUIPMENT_TOTAL_MAX; ++stshId) {
    #define thisStashedButton PDA_LocalButton[PDA_Local.equipmentId[stshId]]

    armorY += ARM_HEIGHT + ARM_GAP;

    switch(localEquipmentDataStored[stshId].type) {
        case EQUIPPED_WORN_ARMOR:
            thisStashedButton = PDA_DisplayArmor(PDA_Local.equipmentId[stshId], ARMOR_DATA, stshId, ARM_X, armorY, ARM_HEIGHT, 0.6);
            break;
        // case EQUIPPED_WORN_BACKP:
        //     thisStashedButton = PDA_DisplayArmor(PDA_Local.equipmentId[stshId], BACKPACK_DATA, stshId, ARM_X, armorY, ARM_HEIGHT, 0.6);
        //     break;
        case EQUIPPED_WORN_BOOTS:
            thisStashedButton = PDA_DisplayArmor(PDA_Local.equipmentId[stshId], BOOTS_DATA, stshId, ARM_X, armorY, ARM_HEIGHT, 0.6);
            break;
    }
}
