// Header
#define CREATE_BEAST_TIER(id, name, color, n) \
    PDA_LocalButton[CONCAT(PDA_BEAST_,id)] = PDA_CreateBeastButton(CONCAT(PDA_BEAST_,id), name, color, 10.0, 40.0 + (15.0 * n), BEAST_DIFFICULTY_WIDTH, BEAST_DIFFICULTY_HEIGHT, -4.0, -3.0, "", ""); \
    PDA_LocalButton[CONCAT(PDA_BEAST_,id)].actionParam = n + 2;

// TODO: pretty little icons to the left
CREATE_BEAST_TIER(UV, "Normal",       CR_WHITE, 0);
CREATE_BEAST_TIER(NM, "Nightmare",    CR_BRICK, 1);
CREATE_BEAST_TIER(TP, "Technophobia", CR_LIGHTBLUE, 2);
CREATE_BEAST_TIER(AG, "Armageddon",   CR_GOLD, 3);
CREATE_BEAST_TIER(EX, "Extra",        CR_PURPLE, 4);

// I'm unsure why I did this..
beast_info[BEAST__PAGE] = PDA_Local.page - 2;

// Body
if (PDA_Local.page != BESTIARY_PAGE_DIFFICULTIES) {
    for (int i = 0; i < DRLA_MONSTER_PAGE_MAX; i++) {
        #define localEnemyActor localListEnemy[list_actor]
        #define localEnemyName localListEnemy[list_name]
        #define beastCount beast_info[BEAST__P_K_COUNT]
        #define killCount localListEnemy[list_kill_count]

        killCount = StrParam("%s:KillCounter", DRLA_Bestiary[beast_info[BEAST__PAGE]][i][beast_TOKEN]);
        monsterCheck[beast_info[BEAST__PAGE]][i]  = CheckInventory(killCount);

        if (CheckInventory(killCount) > 0) {
            localEnemyActor           = DRLA_Bestiary[beast_info[BEAST__PAGE]][i][beast_ACTOR];
            localEnemyName            = StrParam("%l:", StrParam("%l:_name", localEnemyActor));
            localListEnemy[list_icon] = StrParam("%l:", StrParam("%l:_icon", localEnemyActor));
            beastCount                = CheckPointerInventory(killCount, PlayerNumber());
            beast_info[BEAST__WIDTH]  = (StrLen(localEnemyName) * 10) / 2;
        } else {
            localEnemyActor = "null";
            beastCount      = 0;
            localEnemyName  = " ????";
        }

        #define beast_x     (4.0)
        #define beast_y(a)  (50.0 + (16.0 * (a)))
        #define beast_ID(a) (PDA_BEASTS_ID_END - ((a) * 2))

        PDA_LocalButton[beast_ID(i)] = PDA_CreateBeastButton(beast_ID(i), localEnemyName, beast_info[BEAST__LV_COLOR],
            beast_x, beast_y(i),
            beast_info[BEAST__WIDTH], 10,
            3.0, -3.0,
            localEnemyActor, beastCount);
    }
}
