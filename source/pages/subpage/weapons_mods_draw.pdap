
// DisplayIcon(player_weapon[player_weapon_current], PDA_ID, 0.5, 0.5, 0, 1);
#define canBeEvil weapon_checks[weapon_checks_isdemonic]

PDA_HudDirtyP(HUDMSG_PLAIN, PDA_INFOID, CR_UNTRANSLATED, /*x*/ 10.0, /*y*/ 20.0 + (20.0 * 1), 0.0, 1.0,
    l:(canBeEvil) 
        ? (CheckInventory(StrParam("%s:DemonArtifacts", player_weapon[player_weapon_current])) ? weapon_info[weapon_info_dualname] : weapon_info[weapon_info_name]) 
        : weapon_info[weapon_info_name],
    s:"\n[\c[LightBlue]",
    i:Weapon_Mod_Quantity[mod_bulk],
    s:"B \c[Red]",
    i:Weapon_Mod_Quantity[mod_power],
    s:"P \c[Green]",
    i:Weapon_Mod_Quantity[mod_agility],
    s:"A \c[Yellow]",
    i:Weapon_Mod_Quantity[mod_technical],
    s:"T \c[Purple]",
    i:Weapon_Mod_Quantity[mod_sniper],
    s:"S \c[Orange]",
    i:Weapon_Mod_Quantity[mod_firestorm],
    s:"F \c[White]",
    i:Weapon_Mod_Quantity[mod_nano],
    s:"N \cr",
    i:(canBeEvil) ? 0 : Weapon_Mod_Quantity[mod_artifact],
    s:"D\c-]\n\n",
    l:"PDA_MODPACK_MAXSUPPORTED",
    s:"\c[Cyan]",
    i:PDA_Local.maxModLimit
);

for (int modPack = PDA_MODMIN; modPack < PDA_MODMAX - 1; modPack++) {
    str selectedMod = StrParam("%s:MODICON", weapon_mods[modPack]);

    float modY = 55.0 + (24.0 * modPack);

    PDA_LocalButton[modPack] = PDA_CreateModPackDisplay(modPack, selectedMod, 
                10.0, modY,
                16, 24, (Weapon_Mod_Quantity[modPack] > 0) ? pulser(4.0, 0.9) : 0.5);
                PDA_ButtonHandler(modPack, true, WEAPON_PAGE_MODPACK_EFFECTS, NO_TOOLTIP, B_ONLY_VISUAL, B_NO_CLEAR);
}

PDA_DefaultFont();
