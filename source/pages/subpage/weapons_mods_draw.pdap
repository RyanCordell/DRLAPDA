DisplayIconScrollable(StrParam("%l:", weapon_info[weapon_info_icon]), PDA_INFOID,
                      (int)(PDA_SCREEN_X_SCALED + PDA_SCREEN_WIDTH_SCALED - 12.0) + X_LEFT_EDGE,
                      (int)(PDA_BODY_Y - 9.0),
                      INF_HOLDTIME, 0.65);

for (int modPack = PDA_MODMIN; modPack < PDA_MODMAX - 1; modPack++) {
    PDA_ButtonHandler(modPack, true, WEAPON_PAGE_MODPACK_EFFECTS, NO_TOOLTIP, B_ONLY_VISUAL, B_NO_CLEAR);
}

if (PDA_ScrollableNeedsDraw) {
    if (canBeEvil) {
        PDA_DrawBodyText(HUDMSG_PLAIN, PDA_INFO2ID, CR_UNTRANSLATED,
            0.0, 0.0, INF_HOLDTIME, OPAQUE, B_IS_SCROLLABLE, DEFAULT_ALIGN, DEFAULT_ALIGN,
            l:(!canBeEvil)
            ? (CheckInventory(StrParam("%s:DemonArtifacts", player_weapon[player_weapon_current])) ? weapon_info[weapon_info_dualname] : weapon_info[weapon_info_name])
            : weapon_info[weapon_info_name],
            s:"\n[\c[LightBlue]",i:Weapon_Mod_Quantity[mod_bulk],s:"B ",
            s:"\c[Red]",i:Weapon_Mod_Quantity[mod_power],s:"P ",
            s:"\c[Green]",i:Weapon_Mod_Quantity[mod_agility],s:"A ",
            s:"\c[Yellow]",i:Weapon_Mod_Quantity[mod_technical],s:"T ",
            s:"\c[Purple]",i:Weapon_Mod_Quantity[mod_sniper],s:"S ",
            s:"\c[Orange]",i:Weapon_Mod_Quantity[mod_firestorm],s:"F ",
            s:"\c[White]",i:Weapon_Mod_Quantity[mod_nano],s:"N ",
            s:"\cr",i:Weapon_Mod_Quantity[mod_artifact],s:"D",
            s:"\c-]\n\n",l:"PDA_MODPACK_MAXSUPPORTED",
            s:"\c[Cyan]",i:PDA_Local.maxModLimit
        );
    } else {
        PDA_DrawBodyText(HUDMSG_PLAIN, PDA_INFO2ID, CR_UNTRANSLATED,
            0.0, 0.0, INF_HOLDTIME, OPAQUE, B_IS_SCROLLABLE, DEFAULT_ALIGN, DEFAULT_ALIGN,
            // I can't ditch this check - akimbo weapons depend on this. See: WSTE-M5, Jackal & Casull, ...
            l:(!canBeEvil)
            ? (CheckInventory(StrParam("%s:DemonArtifacts", player_weapon[player_weapon_current])) ? weapon_info[weapon_info_dualname] : weapon_info[weapon_info_name])
            : weapon_info[weapon_info_name],
            s:"\n[\c[LightBlue]",i:Weapon_Mod_Quantity[mod_bulk],s:"B ",
            s:"\c[Red]",i:Weapon_Mod_Quantity[mod_power],s:"P ",
            s:"\c[Green]",i:Weapon_Mod_Quantity[mod_agility],s:"A ",
            s:"\c[Yellow]",i:Weapon_Mod_Quantity[mod_technical],s:"T ",
            s:"\c[Purple]",i:Weapon_Mod_Quantity[mod_sniper],s:"S ",
            s:"\c[Orange]",i:Weapon_Mod_Quantity[mod_firestorm],s:"F ",
            s:"\c[White]",i:Weapon_Mod_Quantity[mod_nano],s:"N",
            s:"\c-]\n\n",l:"PDA_MODPACK_MAXSUPPORTED",
            s:"\c[Cyan]",i:PDA_Local.maxModLimit
        );
    }
